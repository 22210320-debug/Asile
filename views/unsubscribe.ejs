<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Asile Email Preferences</title>
  <link rel="stylesheet" href="/public/style.css?v=20260811b">
</head>
<body class="priority-body asile-public-page">
  <main class="priority-shell">
    <a class="priority-logo-link" href="/" aria-label="Return to Asile.site">
      <img class="priority-logo" src="/public/asile-logo-ivory.png?v=20260715a" alt="Asile Events">
    </a>
    <section class="priority-card priority-success">
      <% if (valid === 'complete') { %>
        <p class="priority-kicker">EMAIL PREFERENCES</p>
        <h1>YOU HAVE BEEN UNSUBSCRIBED</h1>
        <p>You will no longer receive Asile marketing emails. Ticket, receipt, refund, and important event communications are not affected.</p>
        <a class="priority-button priority-button-secondary" href="/">RETURN TO ASILE.SITE</a>
      <% } else if (valid) { %>
        <p class="priority-kicker">EMAIL PREFERENCES</p>
        <h1>UNSUBSCRIBE FROM ASILE UPDATES?</h1>
        <p>This removes marketing announcements only. Essential ticket and event emails will still be sent.</p>
        <form method="post" action="/email/unsubscribe">
          <input type="hidden" name="token" value="<%= token %>">
          <button class="priority-button" type="submit">UNSUBSCRIBE</button>
        </form>
      <% } else { %>
        <p class="priority-kicker">EMAIL PREFERENCES</p>
        <h1>LINK NOT AVAILABLE</h1>
        <p>This unsubscribe link is invalid or has expired.</p>
        <a class="priority-button priority-button-secondary" href="/">RETURN TO ASILE.SITE</a>
      <% } %>
    </section>
  </main>
</body>
</html>
