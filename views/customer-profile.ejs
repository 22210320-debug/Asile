<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow,noarchive"><title>Customer | Asile Admin</title><link rel="stylesheet" href="/public/style.css?v=20260714f"></head>
<body class="admin-app-body"><div class="admin-app-shell"><%- include('partials/admin-sidebar', { adminShell }) %><main class="admin-app-main admin-customer-profile"><%- include('partials/admin-topbar', { adminShell, pageTitle: 'Customer profile' }) %><a class="text-link" href="/admin/customers">Back to customers</a><header class="customer-profile-header"><div><p class="eyebrow">Customer profile</p><h2><%= customer.fullName || 'Unnamed customer' %></h2><p class="muted"><%= customer.email || 'No email' %> · <%= customer.phone || 'No phone' %><% if (customer.instagramUsername) { %> · @<%= customer.instagramUsername %><% } %></p></div><span class="status-pill marketing-<%= customer.marketingStatus %>"><%= customer.marketingStatus %></span></header>
  <section class="customer-summary-grid"><article><span>Source</span><b><%= customer.source %></b></article><article><span>Tickets purchased</span><b><%= customer.ticketCount %></b></article><article><span>Total spent</span><b><%= money(customer.totalSpent) %></b></article><article><span>Events attended</span><b><%= customer.attendedCount %></b></article></section>
  <section class="customer-profile-section"><h2>Customer status</h2><form method="post" action="/admin/customers/<%= customer.id %>/status" class="inline-edit"><select name="customerStatus"><% customerStatuses.forEach(status => { %><option value="<%= status %>" <%= customer.customerStatus === status ? 'selected' : '' %>><%= status %></option><% }) %></select><button class="button compact command-primary" type="submit">Save status</button></form><p class="muted">First added: <%= new Date(customer.dateFirstAdded).toLocaleString() %> · Most recent activity: <%= new Date(customer.mostRecentActivity).toLocaleString() %></p></section>
  <section class="customer-profile-section"><h2>Ticket purchase history</h2><table class="admin-card-table"><tr><th>Order</th><th>Event</th><th>Tickets</th><th>Amount</th><th>Payment status</th><th>Ticket status</th></tr><% if (!customer.ticketOrders.length) { %><tr><td colspan="6">No ticket orders.</td></tr><% } %><% customer.ticketOrders.forEach(order => { const status = (orderStatusLabel || (x=>x))(order.status); const ticketStatuses = (customer.ticketsByOrder[order.id] || []).map(ticket => ticket.status).join(', '); %><tr><td><%= order.id %></td><td><%= order.eventName || EVENT_NAME || 'Asile event' %></td><td><%= order.qty %></td><td><%= money(order.amount) %></td><td><%= status %></td><td><%= ticketStatuses || (order.status === 'approved_captured' ? 'Tickets not found' : 'Not issued') %></td></tr><% }) %></table></section>
  <section class="customer-profile-section"><h2>Priority List</h2><% if (!customer.priorityEntries.length) { %><p class="muted">No Priority List entries.</p><% } %><% customer.priorityEntries.forEach(entry => { %><div class="customer-detail-card"><b><%= entry.status %></b><span>Submitted <%= new Date(entry.createdAt).toLocaleString() %></span><span>Attended before: <%= entry.attendedBefore || 'Not specified' %></span><span>Heard via: <%= entry.referralSource || 'Not specified' %></span></div><% }) %></section>
  <section class="customer-profile-section"><h2>Marketing permission history</h2><table class="admin-card-table"><tr><th>Status</th><th>Source</th><th>Recorded</th><th>Wording</th></tr><% if (!customer.marketingHistory.length) { %><tr><td colspan="4">No marketing permission has been recorded.</td></tr><% } %><% customer.marketingHistory.forEach(item => { %><tr><td><span class="status-pill marketing-<%= item.status %>"><%= item.status %></span></td><td><%= item.source %></td><td><%= new Date(item.occurredAt).toLocaleString() %></td><td><%= item.wording || 'Not recorded' %></td></tr><% }) %></table></section>
  <section class="customer-profile-section"><h2>Email campaign history</h2><p class="muted">No campaign deliveries are recorded. Campaign sending is disabled until a bulk email provider is configured.</p></section>
  <section class="customer-profile-section"><h2>Private admin notes</h2><form method="post" action="/admin/customers/<%= customer.id %>/notes" class="note-form"><label>Add note<textarea name="note" maxlength="2000" required></textarea></label><button class="button compact command-primary" type="submit">Save note</button></form><% customer.notes.forEach(note => { %><article class="customer-note"><p><%= note.note %></p><small><%= note.adminName %> · <%= new Date(note.createdAt).toLocaleString() %></small></article><% }) %></section>
</main></div></body></html>
