<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Asile</title>
  <link rel="stylesheet" href="/public/style.css?v=20260811g">
</head>
<% const isSuccessPage = typeof successPage !== 'undefined' && successPage; %>
<body class="asile-public-page <%= isSuccessPage ? 'success-page' : '' %>">
  <main class="hero <%= isSuccessPage ? 'success-hero' : '' %>">
    <section class="card <%= isSuccessPage ? 'success-card' : '' %>">
      <h1><%= title %></h1>
      <p><%= message %></p>
      <a class="<%= isSuccessPage ? 'button' : '' %>" href="/">Back home</a>
    </section>
  </main>
</body>
</html>
