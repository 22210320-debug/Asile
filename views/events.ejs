<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Current and future experiences from <%= COMPANY_NAME %>.">
  <meta property="og:title" content="Asile Events">
  <meta property="og:description" content="Discover current and future experiences from <%= COMPANY_NAME %>.">
  <meta property="og:image" content="<%= SITE_IMAGE_URL %>">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Asile Events">
  <meta name="twitter:description" content="Discover current and future experiences from <%= COMPANY_NAME %>.">
  <meta name="twitter:image" content="<%= SITE_IMAGE_URL %>">
  <title>Asile Events</title>
  <link rel="icon" type="image/png" sizes="1024x1024" href="/public/favicon.png?v=20260715b">
  <link rel="apple-touch-icon" sizes="1024x1024" href="/public/favicon.png?v=20260715b">
  <link rel="preload" href="/public/sunset-house-party-background.jpg" as="image">
  <link rel="preload" href="/public/underground-red-carpet.jpg" as="image">
  <link rel="stylesheet" href="/public/style.css?v=20260811ad">
  <script src="/public/events-story.js?v=20260811e" defer></script>
</head>
<body class="events-body asile-public-page">
  <header class="events-nav">
    <a class="events-brand" href="/" aria-label="Return to <%= COMPANY_NAME %>">
      <img src="/public/asile-logo-ivory.png?v=20260715a" alt="<%= COMPANY_NAME %> Events">
    </a>
    <nav aria-label="Asile links">
      <a href="/waitlist">Priority List</a>
      <a href="<%= INSTAGRAM_URL %>" target="_blank" rel="noopener">Instagram</a>
    </nav>
  </header>

  <% const undergroundEvent = futureEvents.find(event => event.id === 'from-horizon-to-underground-2026'); %>
  <% const otherFutureEvents = futureEvents.filter(event => event.id !== 'from-horizon-to-underground-2026'); %>
  <main class="events-hub events-story">
    <% if (undergroundEvent) { %>
      <section class="events-transition" aria-label="Transition from Sunset House Party to the next Asile experience">
        <div class="events-transition-sticky">
          <div class="events-transition-sunset" aria-hidden="true"></div>
          <div class="events-transition-darkness" aria-hidden="true"></div>
          <div class="events-transition-underground" aria-hidden="true"></div>
          <article class="transition-sunset-content" aria-labelledby="previous-event-heading">
            <p class="eyebrow">Previous event</p>
            <h1 id="previous-event-heading"><%= EVENT_NAME %></h1>
            <p class="transition-event-meta"><%= EVENT_DATE %> <span aria-hidden="true">/</span> <%= EVENT_LOCATION %></p>
            <p>An <%= DRESS_CODE.toLowerCase() %> sunset gathering shaped by house music, a curated guest list, and the people who filled the horizon with us.</p>
            <span class="event-state event-state-sold-out">Completed</span>
          </article>
          <div class="events-transition-copy">
            <span class="events-transition-pretitle">The sun has set.</span>
            <p aria-label="From the horizon to the underground">
              <span>From the horizon</span>
              <span>To the underground.</span>
            </p>
          </div>
          <article class="transition-underground-content" aria-labelledby="underground-event-heading">
            <p class="eyebrow">Next Asile experience</p>
            <h2 id="underground-event-heading"><%= undergroundEvent.name %></h2>
            <dl class="transition-underground-facts">
              <div><dt>Date</dt><dd><%= undergroundEvent.eventDate %></dd></div>
              <div><dt>Time</dt><dd><%= undergroundEvent.eventTime %></dd></div>
              <div><dt>Venue</dt><dd><%= undergroundEvent.location %></dd></div>
              <div><dt>Dress</dt><dd><%= undergroundEvent.dressCode %></dd></div>
              <div><dt>Entry</dt><dd><%= undergroundEvent.minimumAge %>+</dd></div>
              <div><dt>Capacity</dt><dd><%= undergroundEvent.capacityLabel || 'Limited' %></dd></div>
            </dl>
            <p class="transition-entry-note"><%= undergroundEvent.entryPolicy %></p>
            <div class="underground-event-actions">
              <a class="button" href="/events/<%= encodeURIComponent(undergroundEvent.id) %>#reserve">Reserve now</a>
              <a class="button secondary" href="/waitlist">Join Priority List</a>
            </div>
          </article>
        </div>
      </section>

      <section class="underground-details" aria-labelledby="underground-details-heading">
        <div class="underground-details-inner">
          <div class="underground-details-heading">
            <p class="eyebrow">Event details</p>
            <h2 id="underground-details-heading">Built for the underground.</h2>
          </div>
          <div class="underground-details-grid">
            <article><b>Theme</b><span><%= undergroundEvent.theme %></span></article>
            <a href="<%= undergroundEvent.mapUrl %>" target="_blank" rel="noopener"><b>Location</b><span><%= undergroundEvent.location %></span><img src="/public/warshe-pub-logo.png" alt="Warshe Pub logo" loading="lazy" decoding="async"></a>
            <article><b>Dress code</b><span><%= undergroundEvent.dressCode %></span></article>
            <article><b>Capacity</b><span><%= undergroundEvent.capacityLabel || 'Limited capacity' %></span></article>
            <article class="underground-sponsor"><b>Official beer sponsor</b><img src="<%= undergroundEvent.sponsorLogoUrl %>" alt="<%= undergroundEvent.sponsorName %> logo" loading="lazy" decoding="async"></article>
            <% (undergroundEvent.partners || []).forEach(partner => { %><article><b><%= partner.name %></b><span><%= partner.role %></span></article><% }) %>
            <article><b>Payment</b><span>Apple Pay, Visa card, Google Pay</span></article>
          </div>
        </div>
      </section>
    <% } %>

    <% if (otherFutureEvents.length) { %>
      <section class="future-events" aria-labelledby="future-events-list-heading">
        <div class="events-section-heading">
          <div>
            <p class="eyebrow">Coming up</p>
            <h2 id="future-events-list-heading">Future experiences</h2>
          </div>
        </div>
        <div class="future-events-grid">
          <% otherFutureEvents.forEach(event => { %>
            <article class="future-event-card">
              <% if (event.imageUrl) { %><img src="<%= event.imageUrl %>" alt="<%= event.name %>" loading="lazy" decoding="async"><% } %>
              <p><%= event.eventDate %><% if (event.eventTime) { %> · <%= event.eventTime %><% } %></p>
              <h3><%= event.name %></h3>
              <span><%= event.location %></span>
              <span><%= money(event.ticketPrice) %> · <%= event.capacity %> guests</span>
              <% if (event.description) { %><div><%= event.description %></div><% } %>
              <a class="text-link" href="/events/<%= encodeURIComponent(event.id) %>">View event</a>
            </article>
          <% }) %>
        </div>
      </section>
    <% } %>

    <section class="events-priority" aria-labelledby="future-events-heading">
      <div>
        <p class="eyebrow">Priority List</p>
        <h2 id="future-events-heading">First access to what comes next.</h2>
        <p>Priority List is for people who want to hear about future experiences before tickets are released publicly.</p>
      </div>
      <div class="events-priority-actions">
        <a class="button" href="/waitlist">Join Priority List</a>
        <a class="text-link" href="<%= INSTAGRAM_URL %>" target="_blank" rel="noopener">Follow Asile on Instagram</a>
      </div>
    </section>
  </main>
</body>
</html>
