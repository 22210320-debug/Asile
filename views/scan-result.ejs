<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <title>Ticket scan | Asile</title>
  <link rel="stylesheet" href="/public/style.css?v=20260714f">
</head>
<body>
  <main class="hero">
    <section class="card">
      <% if (scanError) { %>
        <p class="bad" role="alert">Check-in could not be saved. Please try again. You can return to the scanner below.</p>
      <% } %>
      <% if (!ticket) { %>
        <h1 class="bad">Invalid ticket</h1>
        <p>This QR code does not match a ticket in the system.</p>
      <% } else if (ticket.status === 'used') { %>
        <% const ticketName = ticket.attendeeName || [ticket.attendeeFirstName, ticket.attendeeLastName].filter(Boolean).join(' ') || ticket.buyerName || 'Unnamed guest'; %>
        <h1 class="<%= justCheckedIn ? 'good' : 'bad' %>"><%= justCheckedIn ? 'Checked in successfully' : 'Already used' %></h1>
        <p><b>ID:</b> <%= ticket.id %></p>
        <p><b>Name:</b> <%= ticketName %></p>
        <p><b><%= justCheckedIn ? 'Checked in at:' : 'Used at:' %></b> <%= ticket.usedAt %></p>
      <% } else if (ticket.status !== 'valid') { %>
        <h1 class="bad">Ticket not active</h1>
        <p>This QR ticket exists, but it has not been assigned to an approved order yet.</p>
        <p><b>ID:</b> <%= ticket.id %></p>
      <% } else { %>
        <% const ticketName = ticket.attendeeName || [ticket.attendeeFirstName, ticket.attendeeLastName].filter(Boolean).join(' ') || ticket.buyerName || 'Unnamed guest'; %>
        <h1 class="good">Valid ticket</h1>
        <p><b>ID:</b> <%= ticket.id %></p>
        <p><b>Name:</b> <%= ticketName %></p>
        <p><b>DOB:</b> <%= ticket.dateOfBirth %></p>
        <p><b>Gender:</b> <%= ticket.gender || 'Not specified' %></p>
        <p><b>Event:</b> <%= ticket.eventName %></p>
        <p><b>Date:</b> <%= ticket.eventDate %> · <%= ticket.eventTime %></p>
        <p><b>Dress code:</b> <%= ticket.dressCode %></p>
        <p><b>Bar:</b> <%= ticket.barPartner || BAR_PARTNER %></p>
        <p><b>Included:</b> <%= ticket.photoBoothPartner || PHOTO_BOOTH_PARTNER %></p>
        <p><b>Sponsor:</b> <%= SPONSOR_NAME %></p>
        <form method="post" action="<%= checkInPath %>"><button type="submit">Check in now</button></form>
      <% } %>
      <p><a href="<%= scanAgainPath %>">Return to scanner</a></p>
    </section>
  </main>
</body>
</html>
