<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Ticket scan</title><link rel="stylesheet" href="/public/style.css?v=20260708c"></head><body><main class="hero"><div class="card"><% if(!ticket){ %><h1 class="bad">Invalid ticket</h1><p>This QR code does not match a ticket in the system.</p><% } else if(ticket.status==='used'){ %><h1 class="bad">Already used</h1><p><b>ID:</b> <%= ticket.id %></p><p><b>Name:</b> <%= ticket.attendeeName %></p><p><b>Used at:</b> <%= ticket.usedAt %></p><% } else if(ticket.status !== 'valid'){ %><h1 class="bad">Ticket not active</h1><p>This QR ticket exists, but it has not been assigned to an approved order yet.</p><p><b>ID:</b> <%= ticket.id %></p><% } else { %><h1 class="good">Valid ticket</h1><p><b>ID:</b> <%= ticket.id %></p><p><b>Name:</b> <%= ticket.attendeeName %></p><p><b>DOB:</b> <%= ticket.dateOfBirth %></p><p><b>Gender:</b> <%= ticket.gender || 'Not specified' %></p><p><b>Event:</b> <%= ticket.eventName %></p><p><b>Date:</b> <%= ticket.eventDate %> · <%= ticket.eventTime %></p><p><b>Dress code:</b> <%= ticket.dressCode %></p><p><b>Bar:</b> <%= ticket.barPartner || BAR_PARTNER %></p><p><b>Included:</b> <%= ticket.photoBoothPartner || PHOTO_BOOTH_PARTNER %></p><p><b>Sponsor:</b> <%= SPONSOR_NAME %></p><form method="post" action="/admin/tickets/<%= ticket.id %>/check-in"><button>Check in now</button></form><% } %><p><a href="/admin/scanner">Scan another</a></p></div></main></body></html>
