<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= COMPANY_NAME %> presents <%= EVENT_NAME %> in <%= EVENT_LOCATION %>. Reserve approved-list QR tickets.">
  <meta property="og:title" content="<%= EVENT_NAME %> | <%= COMPANY_NAME %>">
  <meta property="og:description" content="<%= COMPANY_NAME %> presents <%= EVENT_NAME %> in <%= EVENT_LOCATION %>. Reserve approved-list QR tickets.">
  <meta property="og:image" content="<%= SITE_IMAGE_URL %>">
  <meta property="og:image:secure_url" content="<%= SITE_IMAGE_URL %>">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="512">
  <meta property="og:image:height" content="512">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= EVENT_NAME %> | <%= COMPANY_NAME %>">
  <meta name="twitter:description" content="<%= COMPANY_NAME %> presents <%= EVENT_NAME %> in <%= EVENT_LOCATION %>. Reserve approved-list QR tickets.">
  <meta name="twitter:image" content="<%= SITE_IMAGE_URL %>">
  <title><%= EVENT_NAME %> | <%= COMPANY_NAME %></title>
  <link rel="icon" type="image/png" sizes="1024x1024" href="/public/favicon.png?v=20260715b">
  <link rel="apple-touch-icon" sizes="1024x1024" href="/public/favicon.png?v=20260715b">
  <link rel="preload" href="/public/underground-red-carpet.jpg" as="image" media="(min-width: 761px)">
  <link rel="preload" href="/public/underground-red-carpet-mobile.jpg" as="image" media="(max-width: 760px)">
  <link rel="stylesheet" href="/public/style.css?v=20260811v">
</head>
<body class="asile-public-page event-scene">
  <main class="home-hero modern-home">
    <nav class="home-nav" aria-label="Event links">
      <% if (!privateReserve) { %><a href="/events">Events</a><% } %>
      <% if (!privateReserve) { %><a href="#details">Details</a><% } %>
      <a href="#reserve">Reserve</a>
      <% if (!privateReserve) { %><a href="/waitlist">Priority List</a><% } %>
      <a href="<%= INSTAGRAM_URL %>" target="_blank" rel="noopener">Instagram</a>
    </nav>

    <section class="hero-copy">
      <div class="home-brand-lockup">
        <img class="home-brand-logo" src="/public/asile-logo-ivory.png?v=20260715a" alt="<%= COMPANY_NAME %> Events">
      </div>
      <h1><%= privateReserve ? 'Private Reserve' : (EVENT_DISPLAY_NAME || EVENT_NAME) %></h1>
      <p class="subtitle"><%= privateReserve ? `Invite-only access for ${EVENT_NAME}. Complete checkout here, then admin approval confirms the final QR ticket.` : (EVENT_DESCRIPTION || `An all-white sunset house party in ${EVENT_LOCATION}. House music, approved guest-list entry, named QR tickets, and one free ${PHOTO_BOOTH_PARTNER} picture for every approved guest.`) %></p>
      <div class="hero-event-summary" aria-label="Event summary">
        <span><b>Date</b><%= EVENT_DATE %></span>
        <span><b>Time</b><%= EVENT_TIME %></span>
        <span><b>Location</b><%= EVENT_LOCATION %></span>
      </div>
      <div class="hero-actions">
        <% if (ticketAvailability && ticketAvailability.soldOut) { %>
          <a class="button sold-out-button" href="#reserve">Sold out</a>
        <% } else { %>
          <a class="button" href="#reserve">Reserve now</a>
        <% } %>
        <% if (!privateReserve) { %><a class="button secondary" href="/waitlist">Priority List for future events</a><% } %>
        <% if (!privateReserve) { %><a class="button secondary" href="<%= MAP_URL %>" target="_blank" rel="noopener">Pinned location</a><% } %>
      </div>
    </section>

    <aside class="hero-ticket" aria-label="Event summary">
      <span><b><%= EVENT_DATE %></b>Date</span>
      <span><b><%= EVENT_TIME %></b>Time</span>
      <span><b><%= ticketAvailability && ticketAvailability.soldOut ? 'Sold out' : money(TICKET_PRICE) %></b>Ticket</span>
      <span><b><%= MIN_AGE %>+</b>Age</span>
    </aside>
  </main>

  <% if (!privateReserve) { %>
  <section class="wrap home-wrap" id="details">
    <div class="event-detail-panel">
      <div class="event-detail-copy">
        <p class="eyebrow">Event details</p>
        <h2><%= EVENT_CONCEPT ? 'Closer. Darker. More intimate.' : 'All-white sunset energy, controlled from checkout to the door.' %></h2>
        <p><%= EVENT_CONCEPT || 'Every reservation is reviewed before tickets are issued. Approved guests receive named QR tickets, and the name on each ticket must match ID at entry.' %></p>
        <div class="detail-actions">
          <% if (ticketAvailability && ticketAvailability.soldOut) { %>
            <a class="button sold-out-button" href="#reserve">Sold out</a>
          <% } else { %>
            <a class="button" href="#reserve">Reserve now</a>
          <% } %>
          <a class="button secondary" href="/waitlist">Join Priority List</a>
          <a class="button secondary whatsapp-button" href="https://wa.me/<%= WHATSAPP_1 %>" target="_blank" rel="noopener">WhatsApp</a>
        </div>
      </div>
      <div class="event-detail-grid">
        <span><b>Theme</b><%= EVENT_THEME %></span>
        <a class="detail-bubble detail-link detail-location" href="<%= MAP_URL %>" target="_blank" rel="noopener"><b>Location</b><strong class="detail-location-name"><%= EVENT_LOCATION %></strong><% if (EVENT_LOCATION === 'Warshe Pub') { %><img class="detail-location-logo" src="/public/warshe-pub-logo.png" alt="Warshe Pub logo" loading="lazy" decoding="async"><% } %></a>
        <span><b>Dress</b><%= DRESS_CODE %></span>
        <span><b>Capacity</b><%= EVENT_CAPACITY_LABEL || (ticketAvailability && ticketAvailability.soldOut ? `Sold out · ${CAPACITY}/${CAPACITY}` : `${ticketAvailability ? ticketAvailability.soldOrPending : 0}/${CAPACITY} reserved`) %></span>
        <% if (SPONSOR_LOGO_URL) { %><span class="detail-sponsor"><b>Official beer sponsor</b><img src="<%= SPONSOR_LOGO_URL %>" alt="<%= SPONSOR_NAME %> sponsor logo" loading="lazy" decoding="async"></span><% } %>
        <% (EVENT_PARTNERS || []).forEach(partner => { %><span class="detail-partner"><b><%= partner.name %></b><small><%= partner.role %></small></span><% }) %>
        <span><b>Payment</b>Apple Pay, Visa card, Google Pay</span>
      </div>
    </div>
  </section>

  <section class="wrap feature-strip">
    <article class="image-feature">
      <img src="<%= DJ_IMAGE_URL %>" alt="<%= DJ_NAME %>" loading="lazy" decoding="async">
      <b>Music by <%= DJ_NAME %></b>
      <p>Live loud, stay loco.</p>
    </article>
    <article>
      <b>Approved guest list</b>
      <p>Reservations are checked before payment is captured and tickets are sent.</p>
    </article>
    <article>
      <b>Named QR entry</b>
      <p>Every approved attendee receives a unique QR ticket tied to their name.</p>
    </article>
  </section>

  <% if (EVENT_CONCEPT || EVENT_MUSIC_DESCRIPTION || (EVENT_PARTNERS && EVENT_PARTNERS.length)) { %>
  <section class="wrap underground-experience" aria-label="Event experience">
    <article>
      <p class="eyebrow">Experience partners</p>
      <h2>Built for the underground.</h2>
      <ul class="partner-list">
        <% EVENT_PARTNERS.forEach(partner => { %><li><b><%= partner.name %></b><span><%= partner.role %></span></li><% }) %>
      </ul>
    </article>
    <article>
      <p class="eyebrow">Music</p>
      <h2><%= DJ_NAME %></h2>
      <p><%= EVENT_MUSIC_DESCRIPTION %></p>
    </article>
    <article>
      <p class="eyebrow">The concept</p>
      <h2>From the horizon to the underground.</h2>
      <p><%= EVENT_CONCEPT %></p>
      <% if (EVENT_ENTRY_POLICY) { %><p class="event-entry-policy"><%= EVENT_ENTRY_POLICY %></p><% } %>
    </article>
  </section>
  <% } %>
  <% } %>

  <section class="wrap reserve-wrap <%= privateReserve ? 'private-reserve-wrap' : '' %>" id="reserve">
    <div class="reserve-intro">
      <p class="eyebrow"><%= privateReserve ? 'Private reserve' : 'Reserve tickets' %></p>
      <h2><%= ticketAvailability && ticketAvailability.soldOut ? 'Sold out' : `${money(TICKET_PRICE)} per ticket` %></h2>
      <p class="muted"><%= privateReserve ? 'This page is for invited guests only. Payment authorization is held first; tickets are sent only after admin approval.' : (ticketAvailability && ticketAvailability.soldOut ? 'Tickets are sold out. Follow Instagram or WhatsApp for event updates.' : 'Apple Pay, Visa card, and Google Pay. After approval, check your inbox and spam/junk folder for the QR ticket email.') %></p>
      <div class="payment-badges"><span>Apple Pay</span><span>Visa card</span><span>Google Pay</span></div>
      <% if (privateReserve) { %>
        <div class="private-invite-card">
          <span><b><%= EVENT_DATE %></b>Date</span>
          <span><b><%= EVENT_TIME %></b>Time</span>
          <span><b><%= DRESS_CODE %></b>Dress</span>
        </div>
      <% } %>
    </div>

    <div class="panel reserve-panel">
      <% if (ticketAvailability && ticketAvailability.soldOut) { %>
        <div class="sold-out-panel">
          <p class="eyebrow">Tickets sold out</p>
          <h2>Guest list is full.</h2>
          <p class="muted">All <%= CAPACITY %> tickets are currently reserved or approved. For updates, contact us on WhatsApp or Instagram.</p>
          <div class="hero-actions">
            <a class="button secondary whatsapp-button" href="https://wa.me/<%= WHATSAPP_1 %>" target="_blank" rel="noopener">WhatsApp</a>
            <a class="button secondary" href="<%= INSTAGRAM_URL %>" target="_blank" rel="noopener">Instagram</a>
          </div>
        </div>
      <% } else { %>
      <p class="muted">Each ticket needs a unique attendee first name, last name, date of birth in DD/MM/YYYY format, and gender. All attendees must be <%= MIN_AGE %>+.</p>
      <form action="<%= formAction || '/reserve' %>" method="post" id="ticketForm" data-ticket-price="<%= TICKET_PRICE %>" data-min-age="<%= MIN_AGE %>" data-event-date="<%= EVENT_START_AT %>">
        <% if (privateReserve) { %>
          <label>VIP invite code<input name="vipCode" required autocomplete="off" autocapitalize="characters" placeholder="VIP-CODE"></label>
        <% } %>
        <label>Buyer full name<input name="buyerName" required autocomplete="name" placeholder="Buyer name"></label>
        <label>Buyer email<input type="email" name="buyerEmail" required autocomplete="email" placeholder="you@example.com"></label>
        <label class="marketing-consent"><input type="checkbox" name="marketingConsent" value="on"> <span>Keep me updated about future Asile events, ticket releases, and exclusive announcements.</span></label>
        <label>Quantity
          <span class="quantity-field">
            <input id="quantity" class="quantity-input" type="text" name="quantity" value="1" required inputmode="numeric" autocomplete="off" placeholder="1">
            <span>tickets</span>
          </span>
        </label>
        <p id="quantityWarning" class="bad hidden"></p>
        <div id="attendeeForms"></div>
        <p id="duplicateWarning" class="bad hidden">The same attendee name cannot be used twice.</p>
        <p class="note"><b>Important:</b> <%= privateReserve ? 'this is a private invite link. ' : '' %>Each ticket name must match the attendee ID at the door. Every attendee must wear <%= DRESS_CODE %>. After approval, check spam/junk if you do not see the QR ticket email.</p>
        <p id="ageWarning" class="bad hidden">All attendees must be <%= MIN_AGE %>+ on <%= EVENT_DATE %>.</p>
        <p id="checkoutStatus" class="note hidden"></p>
        <p class="summary"><b>Total:</b> <span id="total"><%= money(TICKET_PRICE) %></span></p>
        <button class="button reserve-submit" type="submit">Reserve & Pay</button>
      </form>
      <% } %>
    </div>
  </section>

<% if (!ticketAvailability || !ticketAvailability.soldOut) { %>
<script src="/public/reservation-form.js?v=20260811e" defer></script>
<% } %>
</body>
</html>
