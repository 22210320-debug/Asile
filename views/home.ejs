<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= COMPANY_NAME %> presents <%= EVENT_NAME %> in <%= EVENT_LOCATION %>. Reserve approved-list QR tickets.">
  <meta property="og:title" content="<%= EVENT_NAME %> | <%= COMPANY_NAME %>">
  <meta property="og:description" content="<%= COMPANY_NAME %> presents <%= EVENT_NAME %> in <%= EVENT_LOCATION %>. Reserve approved-list QR tickets.">
  <meta property="og:image" content="<%= SITE_IMAGE_URL %>">
  <meta property="og:image:secure_url" content="<%= SITE_IMAGE_URL %>">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="512">
  <meta property="og:image:height" content="512">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= EVENT_NAME %> | <%= COMPANY_NAME %>">
  <meta name="twitter:description" content="<%= COMPANY_NAME %> presents <%= EVENT_NAME %> in <%= EVENT_LOCATION %>. Reserve approved-list QR tickets.">
  <meta name="twitter:image" content="<%= SITE_IMAGE_URL %>">
  <title><%= EVENT_NAME %> | <%= COMPANY_NAME %></title>
  <link rel="icon" type="image/png" sizes="512x512" href="/public/favicon.png?v=20260705a">
  <link rel="apple-touch-icon" sizes="512x512" href="/public/favicon.png?v=20260705a">
  <link rel="preload" href="/public/vineyard-sunset.svg" as="image">
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>
  <main class="home-hero modern-home">
    <nav class="home-nav" aria-label="Event links">
      <a href="#details">Details</a>
      <a href="#reserve">Reserve</a>
      <a href="<%= INSTAGRAM_URL %>" target="_blank" rel="noopener">Instagram</a>
    </nav>

    <section class="hero-copy">
      <p class="brand"><%= COMPANY_NAME %></p>
      <h1><%= EVENT_NAME %></h1>
      <p class="subtitle">A private all-white sunset house party in <%= EVENT_LOCATION %>, built around house music, approved guest-list entry, QR tickets, <%= BAR_PARTNER %> at the bar, <%= SPONSOR_NAME %> sponsorship, and one free <%= PHOTO_BOOTH_PARTNER %> picture for every approved guest.</p>
      <div class="hero-actions">
        <a class="button" href="#reserve">Reserve now</a>
        <a class="button secondary" href="<%= MAP_URL %>" target="_blank" rel="noopener">Pinned location</a>
      </div>
    </section>

    <aside class="hero-ticket" aria-label="Event summary">
      <span><b><%= EVENT_DATE %></b>Date</span>
      <span><b><%= EVENT_TIME %></b>Time</span>
      <span><b><%= money(TICKET_PRICE) %></b>Ticket</span>
      <span><b><%= MIN_AGE %>+</b>Age</span>
    </aside>
  </main>

  <section class="wrap home-wrap" id="details">
    <div class="event-detail-panel">
      <div class="event-detail-copy">
        <p class="eyebrow">Event details</p>
        <h2>All-white sunset energy, controlled from checkout to the door.</h2>
        <p>Every reservation is reviewed before tickets are issued. Approved guests receive named QR tickets, and the name on each ticket must match ID at entry.</p>
        <div class="detail-actions">
          <a class="button" href="#reserve">Reserve now</a>
          <a class="button secondary whatsapp-button" href="https://wa.me/<%= WHATSAPP_1 %>" target="_blank" rel="noopener">WhatsApp</a>
        </div>
      </div>
      <div class="event-detail-grid">
        <span><b>Theme</b><%= EVENT_THEME %></span>
        <a class="detail-bubble detail-link" href="<%= MAP_URL %>" target="_blank" rel="noopener"><b>Location</b><%= EVENT_LOCATION %></a>
        <span><b>Dress</b><%= DRESS_CODE %></span>
        <span><b>Capacity</b>Limited guest list</span>
        <span><b>Bar</b><%= BAR_PARTNER %></span>
        <span><b>Sponsor</b><%= SPONSOR_NAME %></span>
        <span><b>Included</b><%= PHOTO_BOOTH_PARTNER %></span>
        <span><b>Payment</b>Apple Pay, Visa card, Google Pay</span>
      </div>
    </div>
  </section>

  <section class="wrap feature-strip">
    <article class="image-feature">
      <img src="<%= DJ_IMAGE_URL %>" alt="<%= DJ_NAME %>" loading="lazy" decoding="async">
      <b>Music by <%= DJ_NAME %></b>
      <p>Live loud, stay loco.</p>
    </article>
    <article>
      <b>Approved guest list</b>
      <p>Reservations are checked before payment is captured and tickets are sent.</p>
    </article>
    <article>
      <b>Named QR entry</b>
      <p>Every approved attendee receives a unique QR ticket tied to their name.</p>
    </article>
    <article>
      <b>Photo-ready night</b>
      <p><%= DRESS_CODE %>, sunset views, house music, and a free <%= PHOTO_BOOTH_PARTNER %> picture.</p>
    </article>
  </section>

  <section class="wrap reserve-wrap" id="reserve">
    <div class="reserve-intro">
      <p class="eyebrow">Reserve tickets</p>
      <h2><%= money(TICKET_PRICE) %> per ticket</h2>
      <p class="muted">Apple Pay, Visa card, and Google Pay. After approval, check your inbox and spam/junk folder for the QR ticket email.</p>
      <div class="payment-badges"><span>Apple Pay</span><span>Visa card</span><span>Google Pay</span></div>
      <div class="sponsor-card fast-sponsor">
        <p class="eyebrow">Event sponsor</p>
        <img src="<%= SPONSOR_LOGO_URL %>" alt="<%= SPONSOR_NAME %> sponsor logo" loading="lazy" decoding="async">
      </div>
    </div>

    <div class="panel reserve-panel">
      <p class="muted">Each ticket needs a unique attendee first name, last name, date of birth in DD/MM/YYYY format, and gender. All attendees must be <%= MIN_AGE %>+.</p>
      <form action="/reserve" method="post" id="ticketForm">
        <label>Buyer full name<input name="buyerName" required autocomplete="name" placeholder="Buyer name"></label>
        <label>Buyer email<input type="email" name="buyerEmail" required autocomplete="email" placeholder="you@example.com"></label>
        <label>Quantity
          <span class="quantity-field">
            <input id="quantity" class="quantity-input" type="text" name="quantity" value="1" required inputmode="numeric" autocomplete="off" placeholder="1">
            <span>tickets</span>
          </span>
        </label>
        <p id="quantityWarning" class="bad hidden"></p>
        <div id="attendeeForms"></div>
        <p id="duplicateWarning" class="bad hidden">The same attendee name cannot be used twice.</p>
        <p class="note"><b>Important:</b> each ticket name must match the attendee ID at the door. Every attendee must wear <%= DRESS_CODE %>. After approval, check spam/junk if you do not see the QR ticket email.</p>
        <p id="ageWarning" class="bad hidden">All attendees must be <%= MIN_AGE %>+ on <%= EVENT_DATE %>.</p>
        <p id="checkoutStatus" class="note hidden"></p>
        <p class="summary"><b>Total:</b> <span id="total"><%= money(TICKET_PRICE) %></span></p>
        <button class="button reserve-submit" type="submit">Reserve & Pay</button>
      </form>
    </div>
  </section>

<script>
const priceCents = <%= TICKET_PRICE %>;
const minAge = <%= MIN_AGE %>;
const eventDate = new Date('2026-07-24T17:30:00');
const quantity = document.getElementById('quantity');
const attendeeForms = document.getElementById('attendeeForms');
const total = document.getElementById('total');
const duplicateWarning = document.getElementById('duplicateWarning');
const quantityWarning = document.getElementById('quantityWarning');
const ageWarning = document.getElementById('ageWarning');
const ticketForm = document.getElementById('ticketForm');
const checkoutStatus = document.getElementById('checkoutStatus');
const reserveSubmit = document.querySelector('.reserve-submit');
function money(cents){ return (cents / 100).toFixed(0) + ' NIS'; }
function quantityError(){
  const value = quantity.value.trim();
  if (!value) return 'Cannot order 0 tickets. Please order at least 1.';
  const raw = Number(value);
  if (!Number.isFinite(raw) || raw < 1) return 'Cannot order 0 tickets. Please order at least 1.';
  if (!Number.isInteger(raw)) return 'Please enter a whole number of tickets.';
  if (raw > 10) return 'Cannot order more than 10 tickets at once.';
  return '';
}
function quantityForForms(){
  const raw = Number(quantity.value.trim() || 0);
  if (!Number.isFinite(raw) || raw < 1) return 1;
  return Math.min(10, Math.floor(raw));
}
function attendeeValues(){
  return [...document.querySelectorAll('.attendee-box')].map(box => ({
    firstName: box.querySelector('.attendee-first-name')?.value || '',
    lastName: box.querySelector('.attendee-last-name')?.value || '',
    dob: box.querySelector('.attendee-dob')?.value || '',
    gender: box.querySelector('.attendee-gender')?.value || ''
  }));
}
function renderForms(){
  const previous = attendeeValues();
  const qty = quantityForForms();
  attendeeForms.innerHTML = '';
  const fragment = document.createDocumentFragment();
  for(let i = 1; i <= qty; i++){
    const saved = previous[i - 1] || {};
    const div = document.createElement('div');
    div.className = 'attendee-box';
    div.innerHTML = `<h3>Ticket ${i}</h3><div class="name-grid"><label>First name<input name="attendeeFirstName" class="attendee-first-name attendee-name-part" required autocomplete="given-name" placeholder="First name"></label><label>Last name<input name="attendeeLastName" class="attendee-last-name attendee-name-part" required autocomplete="family-name" placeholder="Last name"></label></div><label>Date of birth <span class="hint">DD/MM/YYYY</span><input type="text" name="attendeeDob" class="attendee-dob" required inputmode="numeric" autocomplete="bday" maxlength="10" pattern="\\d{2}/\\d{2}/\\d{4}" placeholder="DD/MM/YYYY"></label><p class="age-result muted"></p><label>Gender<select name="attendeeGender" class="attendee-gender" required><option value="">Select gender</option><option value="female">Female</option><option value="male">Male</option></select></label>`;
    div.querySelector('.attendee-first-name').value = saved.firstName || '';
    div.querySelector('.attendee-last-name').value = saved.lastName || '';
    div.querySelector('.attendee-dob').value = saved.dob || '';
    div.querySelector('.attendee-gender').value = saved.gender || '';
    fragment.appendChild(div);
  }
  attendeeForms.appendChild(fragment);
  total.textContent = money(priceCents * qty);
  checkDuplicates();
}
function parseDob(value){
  const match = String(value || '').match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
  if(!match) return null;
  const day = Number(match[1]);
  const month = Number(match[2]);
  const year = Number(match[3]);
  const dob = new Date(year, month - 1, day);
  if(dob.getFullYear() !== year || dob.getMonth() !== month - 1 || dob.getDate() !== day || dob > eventDate) return null;
  return dob;
}
function calculateAge(dobValue){
  const dob = parseDob(dobValue);
  if(!dob) return null;
  let age = eventDate.getFullYear() - dob.getFullYear();
  const monthDiff = eventDate.getMonth() - dob.getMonth();
  if(monthDiff < 0 || (monthDiff === 0 && eventDate.getDate() < dob.getDate())) age--;
  return age;
}
function formatDobInput(input){
  const digits = input.value.replace(/\D/g, '').slice(0, 8);
  let formatted = digits;
  if(digits.length > 4) formatted = digits.slice(0,2) + '/' + digits.slice(2,4) + '/' + digits.slice(4);
  else if(digits.length > 2) formatted = digits.slice(0,2) + '/' + digits.slice(2);
  input.value = formatted;
}
function validateForm(){
  const qtyError = quantityError();
  quantityWarning.textContent = qtyError;
  quantityWarning.classList.toggle('hidden', !qtyError);
  const boxes = [...document.querySelectorAll('.attendee-box')];
  const names = boxes.map(box => ((box.querySelector('.attendee-first-name')?.value || '') + ' ' + (box.querySelector('.attendee-last-name')?.value || '')).trim().toLowerCase().replace(/\s+/g, ' ')).filter(Boolean);
  const hasDupes = new Set(names).size !== names.length;
  duplicateWarning.classList.toggle('hidden', !hasDupes);
  let underAge = false;
  boxes.forEach(box => {
    const dobInput = box.querySelector('.attendee-dob');
    const output = box.querySelector('.age-result');
    const age = calculateAge(dobInput.value);
    if(!dobInput.value){ output.textContent = ''; return; }
    if(dobInput.value.length < 10 || age === null || age < minAge){
      underAge = true;
      output.textContent = dobInput.value.length < 10 ? 'Enter date as DD/MM/YYYY.' : `Not eligible - attendee must be ${minAge}+ on event day.`;
      output.className = 'age-result bad';
    } else {
      output.textContent = `Age on event day: ${age}. Eligible.`;
      output.className = 'age-result good';
    }
  });
  ageWarning.classList.toggle('hidden', !underAge);
  return !qtyError && !hasDupes && !underAge;
}
function checkDuplicates(){ return validateForm(); }
quantity.addEventListener('input', renderForms);
document.addEventListener('input', e => {
  if(e.target.matches('.attendee-dob')) formatDobInput(e.target);
  if(e.target.matches('.attendee-name-part,.attendee-dob,.attendee-gender')) validateForm();
});
ticketForm.addEventListener('submit', e => {
  if(!validateForm()){
    e.preventDefault();
    return;
  }
  reserveSubmit.disabled = true;
  reserveSubmit.textContent = 'Opening secure payment...';
  checkoutStatus.textContent = 'Opening secure payment. Please do not close this page.';
  checkoutStatus.classList.remove('hidden');
  window.setTimeout(() => {
    if(document.visibilityState === 'visible'){
      checkoutStatus.textContent = 'Still opening checkout. If this stays here, refresh and try again, or contact us on WhatsApp.';
      reserveSubmit.disabled = false;
      reserveSubmit.textContent = 'Try again';
    }
  }, 15000);
});
renderForms();
</script>
</body>
</html>
