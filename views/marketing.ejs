<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow,noarchive"><title>Marketing | Asile Admin</title><link rel="stylesheet" href="/public/style.css?v=20260714e"></head>
<body><main class="wrap admin-wrap marketing-wrap"><header class="admin-hero panel"><div><p class="eyebrow">Asile admin</p><h1>Email marketing</h1><p class="muted">Only contacts who explicitly subscribed are eligible.</p></div><nav class="admin-nav"><a href="/admin">Dashboard</a><a href="/admin/customers">Customers</a><a href="/admin/waitlist">Waitlist</a><a href="/admin/logout">Logout</a></nav></header>
  <section class="marketing-warning"><h2>Bulk sending is not configured</h2><p>The current Nodemailer SMTP setup is for transactional ticket emails. It does not provide a safe bulk queue, suppression list, delivery events, bounce handling, or campaign webhooks. Drafts and audience estimates are available, but test and campaign sends remain disabled until an approved bulk provider is configured.</p></section>
  <section class="marketing-estimate"><form method="get" action="/admin/marketing"><label>Audience<select name="audience"><option value="all_subscribed" <%= audience === 'all_subscribed' ? 'selected' : '' %>>All subscribed contacts</option><option value="ticket_buyers" <%= audience === 'ticket_buyers' ? 'selected' : '' %>>Ticket buyers who subscribed</option><option value="priority_access" <%= audience === 'priority_access' ? 'selected' : '' %>>Priority Access members who subscribed</option><option value="event" <%= audience === 'event' ? 'selected' : '' %>>Customers from a selected event</option></select></label><label>Event<select name="selectedEvent"><option value="">Select event</option><% events.forEach(event => { %><option value="<%= event %>" <%= selectedEvent === event ? 'selected' : '' %>><%= event %></option><% }) %></select></label><button class="button compact command-primary" type="submit">Estimate audience</button></form><div><span>Eligible recipients</span><b><%= estimatedRecipientCount %></b></div></section>
  <section class="marketing-compose"><div><p class="eyebrow">Create draft</p><h2>Campaign details</h2><form method="post" action="/admin/marketing/campaigns" class="marketing-form" id="campaignForm"><label>Campaign name<input name="name" required maxlength="120"></label><label>Email subject<input name="subject" id="campaignSubject" required maxlength="180"></label><label>Sender name<input name="senderName" id="campaignSender" value="<%= defaultSenderName %>" required maxlength="100"></label><label>Reply-to email<input name="replyTo" type="email" value="<%= defaultReplyTo %>" required></label><label>Audience<select name="audience"><option value="all_subscribed">All subscribed contacts</option><option value="ticket_buyers">Ticket buyers who subscribed</option><option value="priority_access">Priority Access members who subscribed</option><option value="event">Customers from a selected event</option></select></label><label>Selected event<select name="selectedEvent"><option value="">Not required unless audience is event</option><% events.forEach(event => { %><option value="<%= event %>"><%= event %></option><% }) %></select></label><label>Email body<textarea name="body" id="campaignBody" maxlength="10000" required placeholder="Write the message in plain text. The Asile branded email frame and unsubscribe link are added safely."></textarea></label><button class="button command-primary" type="submit">Save draft</button></form></div><aside class="marketing-preview"><div class="preview-controls"><p class="eyebrow">Preview</p><div><button type="button" class="button compact command-tool preview-mode" data-mode="desktop">Desktop</button><button type="button" class="button compact command-tool preview-mode" data-mode="mobile">Mobile</button></div></div><div class="email-preview-frame" id="emailPreview"><img src="/public/favicon.png" alt="Asile"><p class="preview-subject" id="previewSubject">Your subject</p><div id="previewBody">Your message will appear here.</div><p class="preview-footer">You are receiving this because you opted in to Asile event updates. Unsubscribe</p><p id="previewSender">Asile Events</p></div><p class="note">City audience is unavailable because no city data is currently collected.</p></aside></section>
  <section class="customer-profile-section"><h2>Saved campaigns</h2><table class="admin-card-table"><tr><th>Name</th><th>Subject</th><th>Audience</th><th>Recipients</th><th>Status</th><th>Updated</th><th></th></tr><% if (!campaigns.length) { %><tr><td colspan="7">No campaign drafts yet.</td></tr><% } %><% campaigns.forEach(campaign => { %><tr><td><%= campaign.name %></td><td><%= campaign.subject %></td><td><%= campaign.audience %><%= campaign.selectedEvent ? ': ' + campaign.selectedEvent : '' %></td><td><%= campaign.recipientCount %></td><td><span class="status-pill"><%= campaign.status %></span></td><td><%= new Date(campaign.updatedAt).toLocaleString() %></td><td><form method="post" action="/admin/marketing/campaigns/<%= campaign.id %>/test"><button class="button compact command-tool" type="submit">Test disabled</button></form></td></tr><% }) %></table></section>
</main><script src="/public/marketing-preview.js?v=20260714c" defer></script></body></html>
