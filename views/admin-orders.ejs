<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow,noarchive"><title>Orders | Asile Admin</title><link rel="stylesheet" href="/public/style.css?v=20260811-admin"></head>
<body class="admin-app-body"><div class="admin-app-shell"><%- include('partials/admin-sidebar', { adminShell }) %><main class="admin-app-main"><%- include('partials/admin-topbar', { adminShell, pageTitle: 'Orders' }) %>
<section class="admin-operation-header"><div><p class="admin-page-intro">Review customer payment status and decide which orders need action.</p></div><div class="admin-actions-group"><form method="post" action="/admin/orders/sync-payments"><input type="hidden" name="eventId" value="<%= adminShell.selectedEvent.id %>"><button class="button compact command-tool" type="submit">Sync payments</button></form><form method="post" action="/admin/orders/delete-stuck" onsubmit="return confirm('Delete stuck unpaid orders? Approved orders and tickets will not be deleted.')"><input type="hidden" name="eventId" value="<%= adminShell.selectedEvent.id %>"><button class="button compact command-danger" type="submit">Delete stuck (<%= stats.stuckOrderCount %>)</button></form></div></section>
<form class="admin-search-form admin-operation-toolbar" method="get" action="/admin/orders"><input type="hidden" name="event" value="<%= adminShell.selectedEvent.id %>"><label>Search orders<input name="search" type="search" value="<%= search %>" placeholder="Buyer, attendee, email, ticket or order ID"></label><label>Status<select name="status"><option value="">All statuses</option><option value="pending_admin_approval" <%= selectedStatus === 'pending_admin_approval' ? 'selected' : '' %>>Ready for approval</option><option value="awaiting_payment_authorization" <%= selectedStatus === 'awaiting_payment_authorization' ? 'selected' : '' %>>Awaiting payment</option><option value="approved_captured" <%= selectedStatus === 'approved_captured' ? 'selected' : '' %>>Approved</option><option value="denied_released" <%= selectedStatus === 'denied_released' ? 'selected' : '' %>>Declined</option><option value="cancelled" <%= selectedStatus === 'cancelled' ? 'selected' : '' %>>Cancelled</option></select></label><button class="button compact command-primary" type="submit">Apply</button><a class="button compact command-secondary" href="/admin/orders?event=<%= adminShell.selectedEvent.id %>">Reset</a></form>
<section class="admin-data-section"><p class="muted">Showing <%= orders.length %> of <%= pageInfo.total %> orders.</p><table class="admin-card-table"><tr><th>Buyer</th><th>Attendees</th><th>Email</th><th>Qty</th><th>Amount</th><th>Status</th><th></th></tr><% if (!orders.length) { %><tr><td colspan="7">No orders match these filters.</td></tr><% } %><% orders.forEach(order => { %><tr><td data-label="Buyer"><b><%= order.buyerName %></b></td><td data-label="Attendees"><%= (order.attendees || []).map(attendee => attendee.name).filter(Boolean).join(', ') || order.buyerName %></td><td data-label="Email"><%= order.buyerEmail %></td><td data-label="Qty"><%= order.qty %></td><td data-label="Amount"><%= money(order.amount) %></td><td data-label="Status"><span class="<%= statusClass(order.status) %>"><%= orderStatusLabel(order.status) %></span></td><td data-label="Action" class="row-actions-cell"><a class="button compact row-action" href="/admin/orders/<%= order.id %>">Review</a><form class="inline" method="post" action="/admin/orders/<%= order.id %>/delete" onsubmit="return confirm('Delete this order and its tickets? This cannot be undone.')"><button class="button compact command-danger" type="submit">Delete</button></form></td></tr><% }) %></table><nav class="pager"><% if (pageInfo.hasOlder) { %><a class="button compact" href="<%= pageUrl(pageInfo.page + 1) %>">Older 20</a><% } else { %><span></span><% } %><span>Page <%= pageInfo.page %> of <%= pageInfo.pageCount %></span><% if (pageInfo.hasNewer) { %><a class="button compact" href="<%= pageUrl(pageInfo.page - 1) %>">Newer 20</a><% } else { %><span></span><% } %></nav></section>
</main></div></body></html>
