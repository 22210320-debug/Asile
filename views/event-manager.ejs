<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <title>Event Manager | Asile Admin</title>
  <link rel="stylesheet" href="/public/style.css?v=20260811-admin">
</head>
<body class="admin-app-body">
  <div class="admin-app-shell">
    <%- include('partials/admin-sidebar', { adminShell }) %>
    <main class="admin-app-main event-manager-wrap">
      <%- include('partials/admin-topbar', { adminShell, pageTitle: 'Event manager' }) %>
      <p class="admin-page-intro">Create, publish, and update the event information shown on the public website.</p>

    <% if (notice) { %><p class="note"><%= notice %></p><% } %>

    <section class="event-manager-layout">
      <section class="panel event-editor" aria-labelledby="event-editor-heading">
        <p class="eyebrow"><%= editEvent ? 'Edit listing' : 'New listing' %></p>
        <h2 id="event-editor-heading"><%= editEvent ? editEvent.name : 'Create future event' %></h2>
        <form method="post" action="<%= editEvent ? `/admin/events/${encodeURIComponent(editEvent.id)}` : '/admin/events' %>" class="event-manager-form">
          <label>Event name<input name="name" maxlength="120" required value="<%= editEvent?.name || '' %>"></label>
          <div class="event-manager-date-grid">
            <label>Date<input name="eventDate" type="date" required value="<%= editEvent?.eventDate || '' %>"></label>
            <label>Time<input name="eventTime" maxlength="80" placeholder="Example: 6:00 PM" value="<%= editEvent?.eventTime || '' %>"></label>
          </div>
          <label>Location<input name="location" maxlength="120" required value="<%= editEvent?.location || '' %>"></label>
          <div class="event-manager-date-grid">
            <label>Capacity<input name="capacity" type="number" min="1" max="100000" required value="<%= editEvent?.capacity || '' %>"></label>
            <label>Ticket price (NIS)<input name="ticketPriceNis" type="number" min="0.01" max="100000" step="0.01" required value="<%= typeof editEvent?.ticketPrice === 'number' ? (editEvent.ticketPrice / 100).toFixed(2) : '' %>"></label>
          </div>
          <div class="event-manager-date-grid">
            <label>Theme<input name="theme" maxlength="120" value="<%= editEvent?.theme || '' %>"></label>
            <label>Dress code<input name="dressCode" maxlength="80" value="<%= editEvent?.dressCode || '' %>"></label>
          </div>
          <label>Short description<textarea name="description" maxlength="500" rows="4" placeholder="What guests should know about this experience."><%= editEvent?.description || '' %></textarea></label>
          <label>Image URL <span class="hint">optional</span><input name="imageUrl" type="url" maxlength="500" placeholder="https://..." value="<%= editEvent?.imageUrl || '' %>"></label>
          <label>Visibility<select name="status"><% statuses.forEach(status => { %><option value="<%= status %>" <%= (editEvent?.status || 'draft') === status ? 'selected' : '' %>><%= status === 'published' ? 'Published on /events' : status.charAt(0).toUpperCase() + status.slice(1) %></option><% }) %></select></label>
          <button class="button command-primary" type="submit"><%= editEvent ? 'Save event' : 'Create event' %></button>
          <% if (editEvent) { %><a class="button secondary" href="/admin/events">Cancel edit</a><% } %>
        </form>
        <p class="note">Published listings appear on <a href="/events" target="_blank" rel="noopener">/events</a>. This manager does not create checkout, Stripe products, or QR tickets.</p>
      </section>

      <section class="event-list-panel" aria-labelledby="event-list-heading">
        <div class="admin-section-title">
          <p class="eyebrow">Your listings</p>
          <h2 id="event-list-heading">Future events</h2>
        </div>
        <% if (!events.length) { %>
          <p class="note">No future event listings yet. Create one here, save it as Draft, and publish when you are ready.</p>
        <% } %>
        <div class="managed-event-list">
          <% events.forEach(event => { %>
            <article class="managed-event-item">
              <div>
                <span class="status-pill <%= event.status === 'published' ? 'ticket-status-valid' : 'status-cancelled' %>"><%= event.status %></span>
                <h3><%= event.name %></h3>
                <p><%= event.eventDate %><% if (event.eventTime) { %> · <%= event.eventTime %><% } %> · <%= event.location %></p>
              </div>
              <a class="button compact command-tool" href="/admin/events?edit=<%= encodeURIComponent(event.id) %>">Edit</a>
            </article>
          <% }) %>
        </div>
      </section>
    </section>
    </main>
  </div>
</body>
</html>
