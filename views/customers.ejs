<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow,noarchive"><title>Customers | Asile Admin</title><link rel="stylesheet" href="/public/style.css?v=20260811-admin"></head>
<body class="admin-app-body"><div class="admin-app-shell"><%- include('partials/admin-sidebar', { adminShell }) %><main class="admin-app-main customers-wrap"><%- include('partials/admin-topbar', { adminShell, pageTitle: 'Customers' }) %><p class="admin-page-intro">One customer view across ticket buyers and the Priority List.</p>
  <% if (duplicateCount) { %><details class="note"><summary><b><%= duplicateCount %></b> possible duplicate record(s) need review. They were not automatically merged.</summary><% duplicateCandidates.forEach(candidate => { %><p><b><%= candidate.sourceType %></b> <%= candidate.sourceId %>: <%= candidate.reason %></p><% }) %></details><% } %>
  <section class="customer-toolbar">
    <form method="get" action="/admin/customers" class="customer-filter-form">
      <label>Search<input name="search" type="search" value="<%= filters.search %>" placeholder="Name, email, phone, Instagram"></label>
      <label>Event<select name="event"><option value="">All events</option><% events.forEach(event => { %><option value="<%= event %>" <%= filters.event === event ? 'selected' : '' %>><%= event %></option><% }) %></select></label>
      <label>Source<select name="source"><option value="">All sources</option><option value="Ticket buyer" <%= filters.source === 'Ticket buyer' ? 'selected' : '' %>>Ticket buyer</option><option value="Priority List" <%= filters.source === 'Priority List' ? 'selected' : '' %>>Priority List</option><option value="Both" <%= filters.source === 'Both' ? 'selected' : '' %>>Both</option></select></label>
      <label>Marketing<select name="marketingStatus"><option value="">All permissions</option><% marketingStatuses.forEach(status => { %><option value="<%= status %>" <%= filters.marketingStatus === status ? 'selected' : '' %>><%= status %></option><% }) %></select></label>
      <label>Customer status<select name="customerStatus"><option value="">All statuses</option><% customerStatuses.forEach(status => { %><option value="<%= status %>" <%= filters.customerStatus === status ? 'selected' : '' %>><%= status %></option><% }) %></select></label>
      <label>Sort<select name="sort"><option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest activity</option><option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Oldest first</option><option value="spending" <%= filters.sort === 'spending' ? 'selected' : '' %>>Total spending</option><option value="events" <%= filters.sort === 'events' ? 'selected' : '' %>>Events attended</option></select></label>
      <button class="button compact command-primary" type="submit">Apply</button>
    </form>
    <div class="customer-export-actions"><a class="button compact command-primary" href="/admin/customers/export/marketing.csv">Export marketing contacts</a><a class="button compact command-tool" href="/admin/customers/export/all.csv">Export all customers</a></div>
  </section>
  <p class="muted">Showing <%= customers.length %> of <%= pageInfo.total %> customer(s).</p>
  <div class="customer-table-scroll"><table class="admin-card-table customer-table"><tr><th>Full name</th><th>Email</th><th>Phone</th><th>Instagram</th><th>Source</th><th>Events / tickets</th><th>Spent</th><th>Marketing</th><th>Status</th><th>Activity</th><th></th></tr>
  <% customers.forEach(customer => { %><tr><td data-label="Full name"><b><%= customer.fullName || 'Unnamed' %></b><% if (customer.uncertainDuplicate) { %><small class="table-subtext">Review duplicate</small><% } %></td><td data-label="Email"><%= customer.email || 'Not available' %></td><td data-label="Phone"><%= customer.phone || 'Not available' %></td><td data-label="Instagram"><%= customer.instagramUsername ? '@' + customer.instagramUsername : 'Not available' %></td><td data-label="Source"><span class="status-pill"><%= customer.source %></span></td><td data-label="Events / tickets"><%= customer.eventCount %> / <%= customer.ticketCount %></td><td data-label="Spent"><%= money(customer.totalSpent) %></td><td data-label="Marketing"><span class="status-pill marketing-<%= customer.marketingStatus %>"><%= customer.marketingStatus %></span></td><td data-label="Status"><%= customer.customerStatus %></td><td data-label="Activity"><%= new Date(customer.mostRecentActivity).toLocaleDateString() %></td><td data-label="Action"><a class="button compact row-action" href="/admin/customers/<%= customer.id %>">Open</a></td></tr><% }) %>
  </table></div>
  <nav class="pager" aria-label="Customer pages"><% if (pageInfo.hasOlder) { %><a class="button compact" href="<%= customerQueryUrl(pageInfo.page + 1, filters) %>">Older 50</a><% } else { %><span></span><% } %><span>Page <%= pageInfo.page %> of <%= pageInfo.pageCount %></span><% if (pageInfo.hasNewer) { %><a class="button compact" href="<%= customerQueryUrl(pageInfo.page - 1, filters) %>">Newer 50</a><% } else { %><span></span><% } %></nav>
</main></div></body></html>
