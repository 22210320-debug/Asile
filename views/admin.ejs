<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <title>Admin</title>
  <link rel="stylesheet" href="/public/style.css?v=20260714f">
</head>
<body>
<main class="wrap admin-wrap admin-dashboard" data-admin-dashboard="true" data-awaiting-payments="<%= stats.awaitingPaymentCount %>" data-event-id="<%= selectedEvent.id %>">
  <header class="admin-hero panel admin-page-header">
    <div class="admin-title-block">
      <p class="eyebrow">Asile control</p>
      <h1>Dashboard</h1>
      <p class="admin-event-name"><%= EVENT_NAME %></p>
      <p class="muted admin-environment">Database: <b><%= usePostgres ? "PostgreSQL production database" : "Local JSON development database" %></b></p>
    </div>
    <nav class="admin-nav" aria-label="Admin navigation">
      <a href="/admin/events">Event manager</a>
      <a href="/admin/customers">Customers</a>
      <a href="/admin/marketing">Marketing</a>
      <a href="/admin/waitlist">Priority List</a>
      <a href="/admin/scanner">QR scanner</a>
      <a href="/admin/logout">Logout</a>
    </nav>
  </header>

  <form class="admin-event-switcher" method="get" action="/admin" aria-label="Select event dashboard">
    <label for="adminEvent">Viewing event<select id="adminEvent" name="event" onchange="this.form.submit()"><% eventOptions.forEach(event => { %><option value="<%= event.id %>" <%= selectedEvent.id === event.id ? 'selected' : '' %>><%= event.EVENT_NAME %><%= event.kind === 'current' ? ' (current)' : '' %></option><% }) %></select></label>
    <noscript><button class="button compact command-primary" type="submit">View event</button></noscript>
    <a href="/admin/events" class="button compact command-tool">Manage events</a>
  </form>

  <section class="admin-stats" aria-label="Dashboard stats">
    <div class="metric-card">
      <span>Remaining</span>
      <b><%= stats.remaining %></b>
    </div>
    <div class="metric-card">
      <span>Approved</span>
      <b><%= stats.approvedCount %></b>
    </div>
    <div class="metric-card">
      <span>Pending</span>
      <b><%= stats.pendingCount %></b>
    </div>
    <div class="metric-card ratio-card">
      <span>Female / Male</span>
      <b><%= stats.femaleCount || 0 %> / <%= stats.maleCount || 0 %></b>
      <small><%= stats.femalePercent || 0 %>% / <%= stats.malePercent || 0 %>%</small>
    </div>
    <div class="metric-card alert-card">
      <span>Stuck orders</span>
      <b><%= stats.stuckOrderCount %></b>
    </div>
  </section>

  <% if (notice) { %>
    <p class="note" id="adminNotice"><%= notice %></p>
  <% } else { %>
    <p class="note hidden" id="adminNotice"></p>
  <% } %>

  <details class="panel event-summary admin-event-details">
    <summary><span>Event details</span><span class="summary-action">View</span></summary>
    <div class="event-facts">
      <span><b>Date</b><%= EVENT_DATE %></span>
      <span><b>Time</b><%= EVENT_TIME %></span>
      <span><b>Price</b><%= money(TICKET_PRICE) %></span>
      <span><b>Capacity</b><%= CAPACITY %></span>
      <span><b>Dress</b><%= DRESS_CODE %></span>
      <span><b>Bar</b><%= BAR_PARTNER %></span>
      <span><b>Sponsor</b><%= SPONSOR_NAME %></span>
      <span><b>Included</b><%= PHOTO_BOOTH_PARTNER %></span>
    </div>
  </details>

  <section class="admin-quick-tools" aria-label="Admin tools">
    <div class="admin-subsection-title">
      <p class="eyebrow">Operations</p>
      <h2>Manual tools</h2>
      <p class="muted">Use these only for approved guests and invited VIP access.</p>
    </div>
    <details class="panel admin-collapse">
      <summary>
        <span>Generate manual ticket</span>
        <span class="summary-action">Open</span>
      </summary>
      <form method="post" action="/admin/manual-ticket" class="manual-ticket-form">
        <input type="hidden" name="eventId" value="<%= selectedEvent.id %>">
        <div class="name-grid">
          <label>First name<input name="firstName" required></label>
          <label>Last name<input name="lastName" required></label>
        </div>
        <label>Date of birth<input name="dateOfBirth" class="manual-dob" data-date-format="ddmmyyyy" placeholder="DD/MM/YYYY" inputmode="numeric" maxlength="10" pattern="\d{2}/\d{2}/\d{4}" required><span class="hint">Format: DD/MM/YYYY, example 24/07/2000</span></label>
        <label>Gender<select name="gender" required><option value="">Select gender</option><option value="Female">Female</option><option value="Male">Male</option></select></label>
        <label>Email to send ticket<input type="email" name="buyerEmail" placeholder="optional"></label>
        <button type="submit">Generate new ticket</button>
      </form>
      <p class="note">This creates a valid QR ticket without Stripe. Use it only for approved manual tickets.</p>
    </details>

    <details class="panel admin-collapse">
      <summary>
        <span>VIP invite codes</span>
        <span class="summary-action">Open</span>
      </summary>
      <form method="post" action="/admin/vip-codes" class="manual-ticket-form">
        <input type="hidden" name="eventId" value="<%= selectedEvent.id %>">
        <label>Invite code<input name="code" required placeholder="VIP-001" autocapitalize="characters"></label>
        <label>Max tickets<input name="maxTickets" type="number" min="1" max="10" value="1" required></label>
        <button type="submit">Create VIP code</button>
      </form>
      <table class="admin-card-table">
        <tr><th>Code</th><th>Used</th><th>Status</th><th></th></tr>
        <% (vipCodes || []).forEach(code => { %>
          <tr>
            <td data-label="Code"><%= code.code %></td>
            <td data-label="Used"><%= code.usedTickets || 0 %> / <%= code.maxTickets || 1 %></td>
            <td data-label="Status"><span class="status-pill <%= code.active === false ? 'status-cancelled' : 'ticket-status-valid' %>"><%= code.active === false ? 'Disabled' : 'Active' %></span></td>
            <td data-label="Action" class="row-actions-cell">
              <% if (code.active === false) { %>
                <form class="inline" method="post" action="/admin/vip-codes/<%= code.code %>/enable">
                  <input type="hidden" name="eventId" value="<%= selectedEvent.id %>">
                  <button class="compact-action row-action" type="submit">Enable</button>
                </form>
              <% } else { %>
                <form class="inline" method="post" action="/admin/vip-codes/<%= code.code %>/disable" onsubmit="return confirm('Disable this VIP code?')">
                  <input type="hidden" name="eventId" value="<%= selectedEvent.id %>">
                  <button class="danger compact-action row-action danger-row-action" type="submit">Disable</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </table>
      <p class="note">VIP codes work only on <b>/private-reserve-asile-2026</b>. Each code can reserve up to its max tickets and still requires admin approval.</p>
    </details>
  </section>

  <section class="admin-data-section" aria-labelledby="orders-heading">
  <div class="admin-section-header">
    <div class="admin-section-title">
      <p class="eyebrow">Payments</p>
      <h2 id="orders-heading">Orders</h2>
      <p class="muted">Showing <%= orders.length %> of <%= pagination.orders.total %> order(s)<% if (pagination.searches.orderSearch) { %> matching "<%= pagination.searches.orderSearch %>"<% } %><% if (pagination.searches.orderStatus === 'pending_admin_approval') { %> with status Ready for approval<% } %>. <span id="awaitingPaymentCount"><%= stats.awaitingPaymentCount %></span> order(s) are still waiting for customer payment.</p>
    </div>
  </div>

  <div class="admin-toolbar">
    <form class="admin-search-form" method="get" action="/admin">
      <input type="hidden" name="event" value="<%= selectedEvent.id %>">
      <% if (pagination.searches.ticketSearch) { %><input type="hidden" name="ticketSearch" value="<%= pagination.searches.ticketSearch %>"><% } %>
      <label>Search orders<input name="orderSearch" type="search" value="<%= pagination.searches.orderSearch %>" placeholder="Buyer, email, ticket name, order ID"></label>
      <label>Status
        <select name="orderStatus">
          <option value="">All statuses</option>
          <option value="pending_admin_approval" <%= pagination.searches.orderStatus === 'pending_admin_approval' ? 'selected' : '' %>>Ready for approval</option>
          <option value="awaiting_payment_authorization" <%= pagination.searches.orderStatus === 'awaiting_payment_authorization' ? 'selected' : '' %>>Awaiting payment</option>
          <option value="approved_captured" <%= pagination.searches.orderStatus === 'approved_captured' ? 'selected' : '' %>>Approved</option>
          <option value="denied_released" <%= pagination.searches.orderStatus === 'denied_released' ? 'selected' : '' %>>Rejected</option>
          <option value="authorization_expired" <%= pagination.searches.orderStatus === 'authorization_expired' ? 'selected' : '' %>>Expired</option>
          <option value="cancelled" <%= pagination.searches.orderStatus === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
        </select>
      </label>
      <div class="admin-search-actions">
        <button class="compact-action command-primary" type="submit">Apply</button>
        <% if (pagination.searches.orderSearch || pagination.searches.orderStatus) { %><a class="button compact secondary command-secondary" href="<%= adminPageUrl({ ...pagination.pages, ordersPage: 1 }, 'ordersPage', 1, { ticketSearch: pagination.searches.ticketSearch }) %>">Reset</a><% } %>
      </div>
    </form>
    <div class="admin-actions-group" aria-label="Order tools">
      <form method="post" action="/admin/orders/sync-payments">
        <input type="hidden" name="eventId" value="<%= selectedEvent.id %>">
        <button class="compact-action command-tool" type="submit">Sync payments</button>
      </form>
      <form method="post" action="/admin/orders/repair-issued-statuses" onsubmit="return confirm('Mark pending orders as approved only when tickets already exist for them? This will not charge Stripe or create new tickets.')">
        <input type="hidden" name="eventId" value="<%= selectedEvent.id %>">
        <button class="compact-action command-tool" type="submit">Fix statuses</button>
      </form>
      <form method="post" action="/admin/orders/delete-stuck" onsubmit="return confirm('Delete stuck unpaid orders? Approved orders and tickets will not be deleted.')">
        <input type="hidden" name="eventId" value="<%= selectedEvent.id %>">
        <button class="danger compact-action command-danger" type="submit">Delete stuck (<%= stats.stuckOrderCount %>)</button>
      </form>
    </div>
  </div>

  <table class="admin-card-table">
    <tr><th>Buyer</th><th>Ticket names</th><th>Email</th><th>Qty</th><th>Amount</th><th>Status</th><th></th></tr>
    <% orders.forEach(o=>{ %>
      <tr>
        <td data-label="Buyer"><%= o.buyerName %><% if (o.vipCode) { %><small class="table-subtext">VIP: <%= o.vipCode %></small><% } %></td>
        <td data-label="Ticket names"><%= (o.attendees || []).map(a => a.name).filter(Boolean).join(', ') || o.buyerName %></td>
        <td data-label="Email"><%= o.buyerEmail %></td>
        <td data-label="Qty"><%= o.qty %></td>
        <td data-label="Amount"><%= money(o.amount) %></td>
        <td data-label="Status"><span class="<%= statusClass(o.status) %>"><%= orderStatusLabel(o.status) %></span></td>
        <td data-label="Action" class="row-actions-cell">
          <a class="button compact row-action" href="/admin/orders/<%= o.id %>">Review</a>
          <form class="inline" method="post" action="/admin/orders/<%= o.id %>/delete" onsubmit="return confirm('Delete this order and its tickets? This cannot be undone.')">
            <button class="danger compact-action row-action danger-row-action" type="submit">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </table>
  <nav class="pager" aria-label="Orders pages">
    <% if (pagination.orders.hasOlder) { %>
      <a class="button compact" href="<%= adminPageUrl(pagination.pages, 'ordersPage', pagination.orders.page + 1, pagination.searches) %>">Previous 10</a>
    <% } else { %>
      <span></span>
    <% } %>
    <span>Page <%= pagination.orders.page %> of <%= pagination.orders.pageCount %></span>
    <% if (pagination.orders.hasNewer) { %>
      <a class="button compact" href="<%= adminPageUrl(pagination.pages, 'ordersPage', pagination.orders.page - 1, pagination.searches) %>">Next 10</a>
    <% } else { %>
      <span></span>
    <% } %>
  </nav>
  </section>

  <section class="admin-data-section" aria-labelledby="tickets-heading">
  <div class="admin-section-header">
    <div class="admin-section-title">
      <p class="eyebrow">Entry</p>
      <h2 id="tickets-heading">Tickets</h2>
      <p class="muted"><%= tickets.length %> of <%= pagination.tickets.total %> ticket(s) shown<% if (pagination.searches.ticketSearch) { %> matching "<%= pagination.searches.ticketSearch %>"<% } %></p>
    </div>
    <form class="admin-search-form compact-search" method="get" action="/admin">
      <% if (pagination.searches.orderSearch) { %><input type="hidden" name="orderSearch" value="<%= pagination.searches.orderSearch %>"><% } %>
      <% if (pagination.searches.orderStatus) { %><input type="hidden" name="orderStatus" value="<%= pagination.searches.orderStatus %>"><% } %>
      <label>Search tickets<input name="ticketSearch" type="search" value="<%= pagination.searches.ticketSearch %>" placeholder="Ticket ID, name, email, buyer"></label>
      <div class="admin-search-actions">
        <button class="compact-action command-primary" type="submit">Apply</button>
        <% if (pagination.searches.ticketSearch) { %><a class="button compact secondary command-secondary" href="<%= adminPageUrl({ ...pagination.pages, ticketsPage: 1 }, 'ticketsPage', 1, { orderSearch: pagination.searches.orderSearch }) %>">Reset</a><% } %>
      </div>
    </form>
  </div>

  <table id="ticketsTable" class="admin-card-table">
    <tr><th>ID</th><th>Ticket name</th><th>DOB</th><th>Status</th><th></th></tr>
    <% tickets.forEach(t=>{ %>
      <tr>
        <td data-label="ID"><%= t.id %></td>
        <td data-label="Ticket name"><%= t.attendeeName %></td>
        <td data-label="DOB"><%= t.dateOfBirth %></td>
        <td data-label="Status"><span class="status-pill ticket-status-<%= String(t.status || 'unknown').replace(/[^a-z0-9_-]/gi, '-') %>"><%= t.status %></span></td>
        <td data-label="Action" class="row-actions-cell">
          <form class="inline" method="post" action="/admin/tickets/<%= t.id %>/delete" onsubmit="return confirm('Delete this ticket? This cannot be undone.')">
            <button class="danger compact-action row-action danger-row-action" type="submit">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </table>
  <nav class="pager" aria-label="Ticket pages">
    <% if (pagination.tickets.hasOlder) { %>
      <a class="button compact" href="<%= adminPageUrl(pagination.pages, 'ticketsPage', pagination.tickets.page + 1, pagination.searches) %>">Previous 10</a>
    <% } else { %>
      <span></span>
    <% } %>
    <span>Page <%= pagination.tickets.page %> of <%= pagination.tickets.pageCount %></span>
    <% if (pagination.tickets.hasNewer) { %>
      <a class="button compact" href="<%= adminPageUrl(pagination.pages, 'ticketsPage', pagination.tickets.page - 1, pagination.searches) %>">Next 10</a>
    <% } else { %>
      <span></span>
    <% } %>
  </nav>
  <p class="note"><b>Entry note:</b> Each ticket must match the attendee ID. All guests must be wearing <%= DRESS_CODE %>.</p>
  </section>

  <section class="admin-data-section" aria-labelledby="scans-heading">
  <div class="admin-section-header">
    <div class="admin-section-title">
      <p class="eyebrow">Door</p>
      <h2 id="scans-heading">Recent scan history</h2>
      <p class="muted">Showing <%= (scanHistory || []).length %> of <%= pagination.scans.total %> scan(s).</p>
    </div>
  </div>
  <table class="admin-card-table">
    <tr><th>Ticket</th><th>Admin</th><th>Result</th><th>Time</th></tr>
    <% (scanHistory || []).forEach(s=>{ %>
      <tr>
        <td data-label="Ticket"><%= s.ticketId %></td>
        <td data-label="Admin"><%= s.scannedBy %></td>
        <td data-label="Result"><span class="status-pill"><%= s.result %></span></td>
        <td data-label="Time"><%= s.scannedAt %></td>
      </tr>
    <% }) %>
  </table>
  <nav class="pager" aria-label="Scan history pages">
    <% if (pagination.scans.hasOlder) { %>
      <a class="button compact" href="<%= adminPageUrl(pagination.pages, 'scansPage', pagination.scans.page + 1, pagination.searches) %>">Previous 10</a>
    <% } else { %>
      <span></span>
    <% } %>
    <span>Page <%= pagination.scans.page %> of <%= pagination.scans.pageCount %></span>
    <% if (pagination.scans.hasNewer) { %>
      <a class="button compact" href="<%= adminPageUrl(pagination.pages, 'scansPage', pagination.scans.page - 1, pagination.searches) %>">Next 10</a>
    <% } else { %>
      <span></span>
    <% } %>
  </nav>
  </section>
</main>
<script src="/public/form-inputs.js?v=20260714c" defer></script>
<script src="/public/admin-autorefresh.js"></script>
</body>
</html>
