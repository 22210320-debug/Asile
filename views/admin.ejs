<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin</title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>
<main class="wrap admin-wrap">
  <header class="admin-hero panel">
    <div>
      <p class="eyebrow">Admin dashboard</p>
      <h1><%= EVENT_NAME %></h1>
      <p class="muted">Database mode: <b><%= usePostgres ? "PostgreSQL production database" : "Local JSON development database" %></b></p>
    </div>
    <nav class="admin-nav">
      <a href="/admin/scanner">QR scanner</a>
      <a href="/admin/logout">Logout</a>
    </nav>
  </header>

  <section class="admin-stats" aria-label="Dashboard stats">
    <div class="metric-card">
      <span>Remaining</span>
      <b><%= stats.remaining %></b>
    </div>
    <div class="metric-card">
      <span>Approved</span>
      <b><%= stats.approvedCount %></b>
    </div>
    <div class="metric-card">
      <span>Pending</span>
      <b><%= stats.pendingCount %></b>
    </div>
    <div class="metric-card alert-card">
      <span>Stuck orders</span>
      <b><%= stats.stuckOrderCount %></b>
    </div>
  </section>

  <section class="panel event-summary">
    <div>
      <p class="eyebrow">Event control</p>
      <h2><%= EVENT_NAME %></h2>
    </div>
    <div class="event-facts">
      <span><b>Date</b><%= EVENT_DATE %></span>
      <span><b>Time</b><%= EVENT_TIME %></span>
      <span><b>Price</b><%= money(TICKET_PRICE) %></span>
      <span><b>Capacity</b><%= CAPACITY %></span>
      <span><b>Dress</b><%= DRESS_CODE %></span>
      <span><b>Bar</b><%= BAR_PARTNER %></span>
      <span><b>Sponsor</b><%= SPONSOR_NAME %></span>
      <span><b>Included</b><%= PHOTO_BOOTH_PARTNER %></span>
    </div>
  </section>

  <details class="panel admin-collapse">
    <summary>
      <span>Generate new manual ticket</span>
      <span class="summary-action">Open</span>
    </summary>
    <form method="post" action="/admin/manual-ticket" class="manual-ticket-form">
      <div class="name-grid">
        <label>First name<input name="firstName" required></label>
        <label>Last name<input name="lastName" required></label>
      </div>
      <label>Date of birth<input name="dateOfBirth" placeholder="DD/MM/YYYY" inputmode="numeric" pattern="\d{2}/\d{2}/\d{4}" required><span class="hint">Format: DD/MM/YYYY, example 24/07/2000</span></label>
      <label>Gender<select name="gender" required><option value="">Select gender</option><option value="Female">Female</option><option value="Male">Male</option></select></label>
      <label>Email to send ticket<input type="email" name="buyerEmail" placeholder="optional"></label>
      <button type="submit">Generate new ticket</button>
    </form>
    <p class="note">This creates a new valid QR ticket without Stripe. Use it only for admin-approved manual tickets.</p>
  </details>

  <div class="section-heading admin-section-heading">
    <div>
      <h2>Orders</h2>
      <p class="muted">Showing latest orders. Delete removes the order and its generated tickets.</p>
    </div>
    <form class="inline" method="post" action="/admin/orders/delete-stuck" onsubmit="return confirm('Delete stuck unpaid orders? Approved orders and tickets will not be deleted.')">
      <button class="danger compact-action" type="submit">Delete stuck orders (<%= stats.stuckOrderCount %>)</button>
    </form>
    <form class="inline" method="post" action="/admin/reset-event-data" onsubmit="return confirm('Reset all tickets, orders, and scan history? This cannot be undone.')">
      <button class="danger compact-action" type="submit">Reset tickets/orders</button>
    </form>
  </div>

  <table class="admin-card-table">
    <tr><th>Buyer</th><th>Ticket names</th><th>Email</th><th>Qty</th><th>Amount</th><th>Status</th><th></th></tr>
    <% orders.forEach(o=>{ %>
      <tr>
        <td data-label="Buyer"><%= o.buyerName %></td>
        <td data-label="Ticket names"><%= (o.attendees || []).map(a => a.name).filter(Boolean).join(', ') || o.buyerName %></td>
        <td data-label="Email"><%= o.buyerEmail %></td>
        <td data-label="Qty"><%= o.qty %></td>
        <td data-label="Amount"><%= money(o.amount) %></td>
        <td data-label="Status"><span class="status-pill"><%= o.status %></span></td>
        <td data-label="Action">
          <a class="button compact" href="/admin/orders/<%= o.id %>">Review</a>
          <form class="inline" method="post" action="/admin/orders/<%= o.id %>/delete" onsubmit="return confirm('Delete this order and its tickets? This cannot be undone.')">
            <button class="danger compact-action" type="submit">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </table>

  <div class="section-heading admin-section-heading">
    <div>
      <h2>Tickets</h2>
      <p class="muted" id="ticketSearchCount"><%= tickets.length %> ticket(s) shown</p>
    </div>
    <label class="ticket-search">Search<input id="ticketSearch" type="search" placeholder="Ticket ID or attendee name"></label>
  </div>

  <table id="ticketsTable" class="admin-card-table">
    <tr><th>ID</th><th>Ticket name</th><th>DOB</th><th>Status</th><th></th></tr>
    <% tickets.forEach(t=>{ %>
      <tr data-search="<%= `${t.id || ''} ${t.attendeeName || ''}`.toLowerCase() %>">
        <td data-label="ID"><%= t.id %></td>
        <td data-label="Ticket name"><%= t.attendeeName %></td>
        <td data-label="DOB"><%= t.dateOfBirth %></td>
        <td data-label="Status"><span class="status-pill"><%= t.status %></span></td>
        <td data-label="Action">
          <form class="inline" method="post" action="/admin/tickets/<%= t.id %>/delete" onsubmit="return confirm('Delete this ticket? This cannot be undone.')">
            <button class="danger compact-action" type="submit">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </table>
  <p class="note"><b>Entry note:</b> Each ticket must match the attendee ID. All guests must be wearing <%= DRESS_CODE %>.</p>

  <div class="section-heading admin-section-heading">
    <div>
      <h2>Recent scan history</h2>
      <p class="muted">Latest 20 scans from the door team.</p>
    </div>
  </div>
  <table class="admin-card-table">
    <tr><th>Ticket</th><th>Admin</th><th>Result</th><th>Time</th></tr>
    <% (scanHistory || []).slice(0,20).forEach(s=>{ %>
      <tr>
        <td data-label="Ticket"><%= s.ticketId %></td>
        <td data-label="Admin"><%= s.scannedBy %></td>
        <td data-label="Result"><span class="status-pill"><%= s.result %></span></td>
        <td data-label="Time"><%= s.scannedAt %></td>
      </tr>
    <% }) %>
  </table>
</main>
<script>
  const ticketSearch = document.getElementById('ticketSearch');
  const ticketRows = Array.from(document.querySelectorAll('#ticketsTable tr[data-search]'));
  const ticketSearchCount = document.getElementById('ticketSearchCount');
  ticketSearch?.addEventListener('input', () => {
    const query = ticketSearch.value.trim().toLowerCase();
    let visible = 0;
    for (const row of ticketRows) {
      const match = !query || row.dataset.search.includes(query);
      row.classList.toggle('hidden', !match);
      if (match) visible++;
    }
    ticketSearchCount.textContent = `${visible} ticket(s) shown`;
  });
</script>
<script src="/public/admin-autorefresh.js"></script>
</body>
</html>
