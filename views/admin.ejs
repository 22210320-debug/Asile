<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <title>Dashboard | Asile Admin</title>
  <link rel="stylesheet" href="/public/style.css?v=20260811-admin">
</head>
<body class="admin-app-body">
  <div class="admin-app-shell">
    <%- include('partials/admin-sidebar', { adminShell }) %>
    <main class="admin-app-main admin-dashboard" data-admin-dashboard="true" data-awaiting-payments="<%= stats.awaitingPaymentCount %>" data-event-id="<%= selectedEvent.id %>">
      <%- include('partials/admin-topbar', { adminShell, pageTitle: 'Dashboard' }) %>

      <% if (notice) { %><p class="notice" id="adminNotice" role="status"><%= notice %></p><% } %>

      <section class="admin-overview-heading">
        <div>
          <p class="eyebrow">Selected event</p>
          <h2><%= EVENT_NAME %></h2>
          <p><%= EVENT_DATE %> · <%= EVENT_TIME %> · <%= EVENT_LOCATION %></p>
        </div>
        <a class="button compact command-tool" href="<%= selectedEvent.eventPath || `/events/${encodeURIComponent(selectedEvent.id)}` %>" target="_blank" rel="noopener">Preview event</a>
      </section>

      <section class="admin-overview-stats" aria-label="Event metrics">
        <article><span>Tickets issued</span><b><%= stats.approvedCount %> / <%= CAPACITY %></b></article>
        <article><span>Tickets remaining</span><b><%= stats.remaining %></b></article>
        <article><span>Pending approval</span><b><%= stats.pendingCount %></b></article>
        <article><span>Paid revenue</span><b><%= money(stats.paidRevenue || 0) %></b></article>
        <article><span>Checked in</span><b><%= stats.checkedInCount || 0 %></b></article>
        <article><span>Priority List</span><b><%= prioritySignupCount %></b></article>
      </section>

      <section class="admin-attention" aria-labelledby="attention-heading">
        <div class="admin-section-title"><p class="eyebrow">Operations</p><h2 id="attention-heading">Needs attention</h2></div>
        <div class="admin-attention-list">
          <a href="/admin/orders?event=<%= encodeURIComponent(selectedEvent.id) %>&status=pending_admin_approval"><b><%= stats.pendingCount %></b><span>guest<%= stats.pendingCount === 1 ? '' : 's' %> ready for approval</span></a>
          <a href="/admin/orders?event=<%= encodeURIComponent(selectedEvent.id) %>&status=awaiting_payment_authorization"><b><%= stats.awaitingPaymentCount %></b><span>payment<%= stats.awaitingPaymentCount === 1 ? '' : 's' %> awaiting customer action</span></a>
          <a href="/admin/orders?event=<%= encodeURIComponent(selectedEvent.id) %>"><b><%= stats.stuckOrderCount %></b><span>stuck order<%= stats.stuckOrderCount === 1 ? '' : 's' %> to review</span></a>
        </div>
      </section>

      <section class="admin-quick-actions" aria-label="Quick actions">
        <a class="button command-primary" href="/admin/orders?event=<%= encodeURIComponent(selectedEvent.id) %>&status=pending_admin_approval">Review pending orders</a>
        <a class="button command-tool" href="#manual-tools">Generate ticket</a>
        <a class="button command-tool" href="/admin/scanner">QR check-in</a>
        <a class="button command-tool" href="/admin/events">Manage event</a>
        <a class="button command-tool" href="/admin/marketing">Create campaign</a>
      </section>

      <div class="admin-dashboard-grid">
        <section class="admin-data-section" id="orders" aria-labelledby="orders-heading">
          <div class="admin-section-header"><div class="admin-section-title"><p class="eyebrow">Payments</p><h2 id="orders-heading">Recent orders</h2></div><a href="/admin/orders?event=<%= encodeURIComponent(selectedEvent.id) %>" class="text-link">Open orders</a></div>
          <table class="admin-card-table"><tr><th>Buyer</th><th>Tickets</th><th>Amount</th><th>Status</th><th></th></tr>
            <% if (!orders.length) { %><tr><td colspan="5">No orders for this event yet.</td></tr><% } %>
            <% orders.forEach(order => { %><tr><td data-label="Buyer"><b><%= order.buyerName %></b><small class="table-subtext"><%= order.buyerEmail %></small></td><td data-label="Tickets"><%= order.qty %></td><td data-label="Amount"><%= money(order.amount) %></td><td data-label="Status"><span class="<%= statusClass(order.status) %>"><%= orderStatusLabel(order.status) %></span></td><td data-label="Action"><a class="button compact row-action" href="/admin/orders/<%= order.id %>">Review</a></td></tr><% }) %>
          </table>
        </section>

        <section class="admin-data-section" id="checkins" aria-labelledby="checkins-heading">
          <div class="admin-section-header"><div class="admin-section-title"><p class="eyebrow">Door</p><h2 id="checkins-heading">Recent check-ins</h2></div><a href="/admin/scanner" class="text-link">Open check-in</a></div>
          <table class="admin-card-table"><tr><th>Ticket</th><th>Result</th><th>Time</th></tr>
            <% if (!(scanHistory || []).length) { %><tr><td colspan="3">No tickets have been scanned yet.</td></tr><% } %>
            <% (scanHistory || []).forEach(scan => { %><tr><td data-label="Ticket"><%= scan.ticketId %></td><td data-label="Result"><span class="status-pill"><%= String(scan.result || '').replace(/_/g, ' ') %></span></td><td data-label="Time"><%= new Date(scan.scannedAt).toLocaleString() %></td></tr><% }) %>
          </table>
        </section>
      </div>

      <section id="manual-tools" class="admin-manual-tools" aria-labelledby="manual-tools-heading">
        <div class="admin-section-title"><p class="eyebrow">Admin tools</p><h2 id="manual-tools-heading">Manual operations</h2></div>
        <details class="admin-collapse"><summary>Generate manual ticket <span>Open</span></summary><form method="post" action="/admin/manual-ticket" class="manual-ticket-form"><input type="hidden" name="eventId" value="<%= selectedEvent.id %>"><div class="name-grid"><label>First name<input name="firstName" required></label><label>Last name<input name="lastName" required></label></div><label>Date of birth<input name="dateOfBirth" class="manual-dob" data-date-format="ddmmyyyy" placeholder="DD/MM/YYYY" inputmode="numeric" maxlength="10" pattern="\d{2}/\d{2}/\d{4}" required></label><label>Gender<select name="gender" required><option value="">Select gender</option><option value="Female">Female</option><option value="Male">Male</option></select></label><label>Email to send ticket<input type="email" name="buyerEmail" placeholder="optional"></label><button class="button command-primary" type="submit">Generate ticket</button></form></details>
        <details class="admin-collapse"><summary>VIP invite codes <span>Open</span></summary><form method="post" action="/admin/vip-codes" class="manual-ticket-form"><input type="hidden" name="eventId" value="<%= selectedEvent.id %>"><label>Invite code<input name="code" required placeholder="VIP-001" autocapitalize="characters"></label><label>Max tickets<input name="maxTickets" type="number" min="1" max="10" value="1" required></label><button class="button command-primary" type="submit">Create code</button></form></details>
      </section>
    </main>
  </div>
  <script src="/public/form-inputs.js?v=20260714c" defer></script>
  <script src="/public/admin-autorefresh.js" defer></script>
</body>
</html>
