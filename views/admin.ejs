<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Admin</title><link rel="stylesheet" href="/public/style.css"></head>
<body><main class="wrap">
<h1>Admin dashboard</h1>
<p class="admin-nav"><a href="/admin/scanner">Open camera QR scanner</a><a href="/admin/logout">Logout</a></p><p class="muted">Database mode: <b><%= usePostgres ? "PostgreSQL production database" : "Local JSON development database" %></b></p>
<div class="panel">
  <h2><%= EVENT_NAME %></h2>
  <p><b>Date:</b> <%= EVENT_DATE %> · <b>Time:</b> <%= EVENT_TIME %> · <b>Price:</b> <%= money(TICKET_PRICE) %> · <b>Capacity:</b> <%= CAPACITY %> · <b>Remaining/private:</b> <%= stats.remaining %> · <b>Dress:</b> <%= DRESS_CODE %></p>
  <p><b>Bar:</b> <%= BAR_PARTNER %> · <b>Sponsor:</b> <%= SPONSOR_NAME %> · <b>Included:</b> <%= PHOTO_BOOTH_PARTNER %></p>
  <p><b>Approved gender ratio:</b> Female <%= stats.approvedGender.female %> (<%= stats.approvedGender.femalePercent %>%) · Male <%= stats.approvedGender.male %> (<%= stats.approvedGender.malePercent %>%)</p>
  <p><b>Pending gender ratio:</b> Female <%= stats.pendingGender.female %> (<%= stats.pendingGender.femalePercent %>%) · Male <%= stats.pendingGender.male %> (<%= stats.pendingGender.malePercent %>%)</p>
</div>
<h2>Generate new manual ticket</h2>
<div class="panel">
  <form method="post" action="/admin/manual-ticket">
    <div class="name-grid">
      <label>First name<input name="firstName" required></label>
      <label>Last name<input name="lastName" required></label>
    </div>
    <label>Date of birth<input name="dateOfBirth" placeholder="DD/MM/YYYY" inputmode="numeric" pattern="\d{2}/\d{2}/\d{4}" required><span class="hint">Format: DD/MM/YYYY, example 24/07/2000</span></label>
    <label>Gender<select name="gender" required><option value="">Select gender</option><option value="Female">Female</option><option value="Male">Male</option></select></label>
    <label>Email to send ticket<input type="email" name="buyerEmail" placeholder="optional"></label>
    <button type="submit">Generate new ticket</button>
  </form>
  <p class="note">This creates a new valid QR ticket without Stripe. Use it only for admin-approved manual tickets.</p>
</div>
<div class="section-heading">
  <h2>Orders</h2>
  <form class="inline" method="post" action="/admin/orders/delete-stuck" onsubmit="return confirm('Delete stuck unpaid orders? Approved orders and tickets will not be deleted.')">
    <button class="danger compact-action" type="submit">Delete stuck orders (<%= stats.stuckOrderCount %>)</button>
  </form>
</div>
<table class="admin-card-table"><tr><th>Buyer</th><th>Email</th><th>Qty</th><th>Amount</th><th>Status</th><th></th></tr><% orders.forEach(o=>{ %><tr><td data-label="Buyer"><%= o.buyerName %></td><td data-label="Email"><%= o.buyerEmail %></td><td data-label="Qty"><%= o.qty %></td><td data-label="Amount"><%= money(o.amount) %></td><td data-label="Status"><%= o.status %></td><td data-label="Action"><a class="button compact" href="/admin/orders/<%= o.id %>">Review</a></td></tr><% }) %></table>
<h2>Tickets</h2>
<label>Search tickets by ID or name<input id="ticketSearch" type="search" placeholder="Type ticket ID or attendee name"></label>
<p class="muted" id="ticketSearchCount"><%= tickets.length %> ticket(s)</p>
<table id="ticketsTable" class="admin-card-table"><tr><th>ID</th><th>Attendee</th><th>DOB</th><th>Gender</th><th>Status</th></tr><% tickets.forEach(t=>{ %><tr data-search="<%= `${t.id || ''} ${t.attendeeName || ''}`.toLowerCase() %>"><td data-label="ID"><%= t.id %></td><td data-label="Attendee"><%= t.attendeeName %></td><td data-label="DOB"><%= t.dateOfBirth %></td><td data-label="Gender"><%= t.gender || 'Not specified' %></td><td data-label="Status"><%= t.status %></td></tr><% }) %></table><p class="note"><b>Entry note:</b> Each ticket must match the attendee ID. All guests must be wearing <%= DRESS_CODE %>.</p>
<h2>Recent scan history</h2>
<table class="admin-card-table"><tr><th>Ticket</th><th>Admin</th><th>Result</th><th>Time</th></tr><% (scanHistory || []).slice(0,20).forEach(s=>{ %><tr><td data-label="Ticket"><%= s.ticketId %></td><td data-label="Admin"><%= s.scannedBy %></td><td data-label="Result"><%= s.result %></td><td data-label="Time"><%= s.scannedAt %></td></tr><% }) %></table>
<script>
  const ticketSearch = document.getElementById('ticketSearch');
  const ticketRows = Array.from(document.querySelectorAll('#ticketsTable tr[data-search]'));
  const ticketSearchCount = document.getElementById('ticketSearchCount');
  ticketSearch?.addEventListener('input', () => {
    const query = ticketSearch.value.trim().toLowerCase();
    let visible = 0;
    for (const row of ticketRows) {
      const match = !query || row.dataset.search.includes(query);
      row.classList.toggle('hidden', !match);
      if (match) visible++;
    }
    ticketSearchCount.textContent = `${visible} ticket(s)`;
  });
</script>
<script src="/public/admin-autorefresh.js"></script>
</main></body></html>
