<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Get first access to future Asile event releases, private invitations, and sold-out availability updates.">
  <meta property="og:title" content="Asile Priority List">
  <meta property="og:description" content="First access to future Asile event releases, private invitations, and sold-out availability updates.">
  <meta property="og:image" content="<%= SITE_IMAGE_URL %>">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Asile Priority List">
  <meta name="twitter:description" content="First access to future Asile event releases, private invitations, and sold-out availability updates.">
  <meta name="twitter:image" content="<%= SITE_IMAGE_URL %>">
  <title>Asile Priority List</title>
  <link rel="icon" type="image/png" sizes="1024x1024" href="/public/favicon.png?v=20260715b">
  <link rel="apple-touch-icon" sizes="1024x1024" href="/public/favicon.png?v=20260715b">
  <link rel="stylesheet" href="/public/style.css?v=20260715f">
</head>
<body class="priority-body asile-public-page">
  <main class="priority-shell">
    <a class="priority-back" href="/">Back to Asile.site</a>
    <a class="priority-logo-link" href="/" aria-label="Return to Asile.site"><img class="priority-logo" src="/public/favicon.png?v=20260715b" alt="Asile Events"></a>

    <% if (success) { %>
      <section class="priority-card priority-success" aria-live="polite">
        <p class="priority-kicker">PRIVATE ACCESS</p>
        <h1>YOU’RE ON THE LIST</h1>
        <p>Thank you for joining the Asile community.</p>
        <p>We’ll contact you if availability opens or when Priority List access becomes available for our next experience.</p>
        <p class="priority-note">Joining the list does not guarantee admission or a ticket.</p>
        <div class="priority-actions">
          <a class="priority-button" href="<%= INSTAGRAM_URL %>" target="_blank" rel="noopener">FOLLOW ASILE ON INSTAGRAM</a>
          <a class="priority-button priority-button-secondary" href="/">RETURN TO ASILE.SITE</a>
        </div>
      </section>
    <% } else { %>
      <section class="priority-card">
        <p class="priority-kicker">PRIVATE ACCESS</p>
        <h1>FIRST ACCESS TO FUTURE ASILE EVENTS</h1>
        <p class="priority-intro">Join the Asile Priority List for early access to future event releases, private invitations, and exclusive announcements.</p>
        <p class="priority-soldout">The current event is sold out. Join the Priority List to hear first if places reopen and to receive early access to upcoming Asile experiences.</p>
        <div class="priority-benefits" aria-label="Priority List benefits">
          <span>Early ticket releases</span>
          <span>Private event invitations</span>
          <span>Sold-out availability updates</span>
        </div>

        <% if (error) { %><p class="priority-error" role="alert"><%= error %></p><% } %>
        <form method="post" action="/waitlist" class="priority-form" id="priorityForm" novalidate>
          <div class="priority-honeypot" aria-hidden="true">
            <label>Company<input name="company" tabindex="-1" autocomplete="off"></label>
          </div>
          <label for="fullName">FULL NAME<input id="fullName" name="fullName" required autocomplete="name" maxlength="100" value="<%= values.fullName || '' %>"></label>
          <label for="phone">PHONE NUMBER<input id="phone" name="phone" type="tel" required inputmode="tel" autocomplete="tel" maxlength="32" placeholder="+970 5X XXX XXXX" value="<%= values.phone || '+970 ' %>" aria-describedby="phoneHint"></label>
          <span id="phoneHint" class="priority-hint">Palestine is selected by default. Include your country code.</span>
          <label for="email">EMAIL ADDRESS<input id="email" name="email" type="email" required autocomplete="email" maxlength="254" value="<%= values.email || '' %>"></label>
          <label for="instagramUsername">INSTAGRAM USERNAME<input id="instagramUsername" name="instagramUsername" required autocapitalize="none" autocomplete="off" maxlength="31" placeholder="yourusername" value="<%= values.instagramUsername || '' %>"></label>
          <label for="attendedBefore">HAVE YOU ATTENDED AN ASILE EVENT BEFORE? <span>OPTIONAL</span>
            <select id="attendedBefore" name="attendedBefore">
              <option value="">Select an answer</option>
              <option value="Yes" <%= values.attendedBefore === 'Yes' ? 'selected' : '' %>>Yes</option>
              <option value="No" <%= values.attendedBefore === 'No' ? 'selected' : '' %>>No</option>
            </select>
          </label>
          <label for="referralSource">HOW DID YOU HEAR ABOUT ASILE? <span>OPTIONAL</span>
            <select id="referralSource" name="referralSource">
              <option value="">Select an answer</option>
              <% ['Instagram', 'Friend', 'Previous Asile event', 'TikTok', 'Other'].forEach(source => { %><option value="<%= source %>" <%= values.referralSource === source ? 'selected' : '' %>><%= source %></option><% }) %>
            </select>
          </label>
          <label class="priority-consent" for="consent"><input id="consent" name="consent" type="checkbox" required> <span>I agree to receive event updates and Priority List announcements from Asile Events. I understand that joining the list does not guarantee a ticket or admission.</span></label>
          <p class="priority-privacy">Your information will only be used for Asile event communication and guest management. We will not sell your information.</p>
          <button class="priority-button priority-submit" type="submit">JOIN PRIORITY LIST</button>
          <p class="priority-submit-note">Joining does not guarantee a ticket or admission.</p>
          <p id="priorityLoading" class="priority-loading" aria-live="polite"></p>
        </form>
      </section>
    <% } %>
  </main>
  <% if (!success) { %>
  <script src="/public/priority-access-form.js?v=20260714c" defer></script>
  <% } %>
</body>
</html>
