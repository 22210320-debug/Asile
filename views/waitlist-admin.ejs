<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <title>Priority Access | Asile Admin</title>
  <link rel="stylesheet" href="/public/style.css?v=20260714a">
</head>
<body>
  <main class="wrap admin-wrap waitlist-admin-wrap">
    <header class="admin-hero panel">
      <p class="eyebrow">Asile admin</p>
      <h1>Priority Access</h1>
      <nav class="admin-nav" aria-label="Admin navigation">
        <a href="/admin">Dashboard</a>
        <a href="/admin/scanner">QR scanner</a>
        <a href="/admin/logout">Logout</a>
      </nav>
    </header>
    <section class="stat-grid waitlist-stats" aria-label="Priority Access stats">
      <article class="stat"><span>Total people</span><b><%= totalAll %></b></article>
      <article class="stat"><span>New today</span><b><%= newToday %></b></article>
    </section>
    <% if (notice) { %><p class="note"><%= notice %></p><% } %>
    <section class="waitlist-admin-tools">
      <form class="waitlist-search" method="get" action="/admin/waitlist">
        <label for="waitlistSearch">Search<input id="waitlistSearch" name="search" type="search" value="<%= search %>" placeholder="Name, phone, email, Instagram"></label>
        <label for="waitlistStatus">Status<select id="waitlistStatus" name="status"><option value="">All statuses</option><% statuses.forEach(status => { %><option value="<%= status %>" <%= selectedStatus === status ? 'selected' : '' %>><%= status.charAt(0).toUpperCase() + status.slice(1) %></option><% }) %></select></label>
        <button class="button compact command-primary" type="submit">Search</button>
      </form>
      <a class="button compact command-tool" href="/admin/waitlist/export.csv">Export CSV</a>
    </section>
    <p class="muted">Showing <%= entries.length %> of <%= pageInfo.total %> matching Priority Access record(s), newest first.</p>
    <div class="waitlist-records">
      <% if (!entries.length) { %><p class="note">No Priority Access records match this search.</p><% } %>
      <% entries.forEach(entry => { %>
        <article class="waitlist-record">
          <div class="waitlist-record-main">
            <h2><%= entry.fullName %></h2>
            <p><a href="mailto:<%= entry.email %>"><%= entry.email %></a> · <a href="tel:<%= entry.phone %>"><%= entry.phone %></a></p>
            <dl>
              <div><dt>Instagram</dt><dd>@<%= entry.instagramUsername %></dd></div>
              <div><dt>Attended before</dt><dd><%= entry.attendedBefore || 'Not specified' %></dd></div>
              <div><dt>Heard via</dt><dd><%= entry.referralSource || 'Not specified' %></dd></div>
              <div><dt>Submitted</dt><dd><%= new Date(entry.createdAt).toLocaleString() %></dd></div>
            </dl>
          </div>
          <form class="waitlist-status-form" method="post" action="/admin/waitlist/<%= entry.id %>/status">
            <label>Status<select name="status"><% statuses.forEach(status => { %><option value="<%= status %>" <%= entry.status === status ? 'selected' : '' %>><%= status.charAt(0).toUpperCase() + status.slice(1) %></option><% }) %></select></label>
            <button class="button compact command-primary" type="submit">Save</button>
          </form>
        </article>
      <% }) %>
    </div>
    <nav class="pager" aria-label="Priority Access pages">
      <% if (pageInfo.hasOlder) { %><a class="button compact" href="<%= waitlistPageUrl(pageInfo.page + 1) %>">Older 50</a><% } else { %><span></span><% } %>
      <span>Page <%= pageInfo.page %> of <%= pageInfo.pageCount %></span>
      <% if (pageInfo.hasNewer) { %><a class="button compact" href="<%= waitlistPageUrl(pageInfo.page - 1) %>">Newer 50</a><% } else { %><span></span><% } %>
    </nav>
  </main>
</body>
</html>
