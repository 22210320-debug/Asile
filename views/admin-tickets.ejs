<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow,noarchive"><title>Tickets | Asile Admin</title><link rel="stylesheet" href="/public/style.css?v=20260811-admin"></head>
<body class="admin-app-body"><div class="admin-app-shell"><%- include('partials/admin-sidebar', { adminShell }) %><main class="admin-app-main"><%- include('partials/admin-topbar', { adminShell, pageTitle: 'Tickets' }) %>
<% if (notice) { %><p class="notice" role="status"><%= notice %></p><% } %>
<section class="admin-operation-header"><p class="admin-page-intro">Search issued tickets, check QR status, or create a manual approved ticket.</p><a class="button compact command-tool" href="/admin/scanner?event=<%= encodeURIComponent(adminShell.selectedEvent.id) %>">Open QR check-in</a></section>
<details class="admin-collapse admin-inline-tool"><summary>Generate manual ticket <span>Open</span></summary><form method="post" action="/admin/manual-ticket" class="manual-ticket-form"><input type="hidden" name="eventId" value="<%= adminShell.selectedEvent.id %>"><div class="name-grid"><label>First name<input name="firstName" required></label><label>Last name<input name="lastName" required></label></div><label>Date of birth<input name="dateOfBirth" class="manual-dob" data-date-format="ddmmyyyy" placeholder="DD/MM/YYYY" inputmode="numeric" maxlength="10" pattern="\d{2}/\d{2}/\d{4}" required></label><label>Gender<select name="gender" required><option value="">Select gender</option><option value="Female">Female</option><option value="Male">Male</option></select></label><label>Email to send ticket<input type="email" name="buyerEmail" placeholder="optional"></label><button class="button command-primary" type="submit">Generate ticket</button></form></details>
<form class="admin-search-form admin-operation-toolbar" method="get" action="/admin/tickets"><input type="hidden" name="event" value="<%= adminShell.selectedEvent.id %>"><label>Search tickets<input name="search" type="search" value="<%= search %>" placeholder="Ticket ID, guest name, email, buyer"></label><button class="button compact command-primary" type="submit">Apply</button><a class="button compact command-secondary" href="/admin/tickets?event=<%= adminShell.selectedEvent.id %>">Reset</a></form>
<section class="admin-data-section"><p class="muted">Showing <%= tickets.length %> of <%= pageInfo.total %> issued tickets.</p><table class="admin-card-table"><tr><th>Ticket ID</th><th>Guest</th><th>Email</th><th>QR status</th><th>Check-in</th><th></th></tr><% if (!tickets.length) { %><tr><td colspan="6">No tickets match this search.</td></tr><% } %><% tickets.forEach(ticket => { const name = [ticket.attendeeFirstName, ticket.attendeeLastName].filter(Boolean).join(' ') || ticket.attendeeName || ticket.buyerName || 'Unnamed attendee'; %><tr><td data-label="Ticket ID"><%= ticket.id %></td><td data-label="Guest"><%= name %></td><td data-label="Email"><%= ticket.buyerEmail || 'Not available' %></td><td data-label="QR status"><span class="status-pill ticket-status-<%= ticket.status %>"><%= ticket.status === 'used' ? 'Used' : 'Valid' %></span></td><td data-label="Check-in"><%= ticket.status === 'used' ? 'Checked in' : 'Not checked in' %></td><td data-label="Action" class="row-actions-cell"><% if (ticket.status === 'used') { %><form method="post" action="/admin/scans/<%= ticket.id %>/reset" onsubmit="return confirm('Reset this ticket so it can be scanned again?')"><button class="button compact command-tool" type="submit">Reset scan</button></form><% } %></td></tr><% }) %></table><nav class="pager"><% if (pageInfo.hasOlder) { %><a class="button compact" href="<%= pageUrl(pageInfo.page + 1) %>">Older 20</a><% } else { %><span></span><% } %><span>Page <%= pageInfo.page %> of <%= pageInfo.pageCount %></span><% if (pageInfo.hasNewer) { %><a class="button compact" href="<%= pageUrl(pageInfo.page - 1) %>">Newer 20</a><% } else { %><span></span><% } %></nav></section>
</main></div><script src="/public/form-inputs.js" defer></script></body></html>
