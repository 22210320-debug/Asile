<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= EVENT_NAME %> | <%= COMPANY_NAME %></title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>
  <main class="home-hero">
    <section class="hero-card glass">
      <p class="brand"><%= COMPANY_NAME %></p>
      <h1><%= EVENT_NAME %></h1>
      <p class="subtitle">A private all-white sunset house party in Cremisan, built around house music, a secure approved guest list, golden-hour vineyard views, Double Shake at the bar, Shepherds Beer sponsorship, and a free Pica Pic photo booth picture for every guest.</p>
      <div class="pills">
        <span><%= EVENT_DATE %></span><span><%= EVENT_TIME %></span><span><%= money(TICKET_PRICE) %></span><span>Apple Pay</span><span>Google Pay</span><span>Visa/cards</span><span><%= MIN_AGE %>+</span><span><%= DRESS_CODE %></span><span>Bar by <%= BAR_PARTNER %></span><span>Sponsored by <%= SPONSOR_NAME %></span><span>Free Pica Pic photo booth picture</span>
      </div>
      <div class="luxury-strip"><div><b>Approved guest list</b><br>Every reservation is reviewed before tickets are issued.</div><div><b>Named QR entry</b><br>Each ticket has a unique QR code and must match ID at the door.</div><div><b>Designed for photos</b><br>All-white theme, Cremisan sunset setting, lighting, music, and Pica Pic photo booth.</div></div>
      <div class="actions">
        <a class="button secondary" href="<%= MAP_URL %>" target="_blank">Pinned location</a>
        <a class="button secondary" href="https://wa.me/<%= WHATSAPP_1 %>" target="_blank">WhatsApp</a>
        <a class="button secondary" href="<%= INSTAGRAM_URL %>" target="_blank">Instagram</a>
      </div>
    </section>
  </main>

  <section class="wrap grid-two">
    <div class="panel">
      <p class="eyebrow">About ASIL'E</p>
      <h2>Every event has its own identity.</h2>
      <p>ASIL'E creates private, polished event experiences where every detail has a purpose. Each event is built with a different identity, from the music direction and guest flow to the visual moments people remember. Sunset House Party is a luxury all-white sunset experience in Cremisan, shaped around house music, golden-hour photos, stage lighting, secure digital tickets, an approved guest list, Double Shake at the bar, Shepherds Beer sponsorship, and one free Pica Pic photo booth picture for every guest.</p>
      <div class="details-list">
        <p><b>Company:</b> <%= COMPANY_NAME %></p>
        <p><b>Event:</b> <%= EVENT_NAME %></p>
        <p><b>Theme:</b> <%= EVENT_THEME %></p>
        <p><b>Location:</b> <%= EVENT_LOCATION %></p>
        <p><b>Private capacity:</b> Limited guest list</p>
        <p><b>Bar experience:</b> <%= BAR_PARTNER %></p>
        <p><b>Sponsor:</b> <%= SPONSOR_NAME %></p><p><b>Included:</b> One free picture at <%= PHOTO_BOOTH_PARTNER %></p>
      </div>
      <div class="sponsor-card"><p class="eyebrow">Event sponsor</p><img src="<%= SPONSOR_LOGO_URL %>" alt="<%= SPONSOR_NAME %> sponsor logo"><p><%= SPONSOR_NAME %> is sponsoring this event.</p></div><div class="sponsor-card"><p class="eyebrow">Included experience</p><p><b><%= PHOTO_BOOTH_PARTNER %>:</b> every approved attendee gets one free picture in the photo booth.</p></div><div class="details-list"><p class="eyebrow">Secure guest experience</p><p>Limited capacity, approved guest list, and QR entry keep the event controlled, organized, and more exclusive. Every attendee receives a named digital ticket with a unique QR code. Names must match ID at the door, which keeps entry smooth, secure, and respectful of the guest list.</p></div>
    </div>

    <div class="panel" id="reserve">
      <p class="eyebrow">Reserve tickets</p>
      <h2><%= money(TICKET_PRICE) %> per ticket</h2><div class="payment-badges"><span>Apple Pay</span><span>Google Pay</span><span>Visa</span><span>Mastercard</span></div><p class="muted">Secure checkout is prepared through Stripe. Apple Pay, Google Pay, Visa, and Mastercard can appear after HTTPS hosting, Stripe keys, and wallet/domain setup are completed.</p>
      <p class="muted">Each ticket must have a unique attendee first name and last name, date of birth in DD/MM/YYYY format, and gender. All attendees must be <%= MIN_AGE %>+. Every ticket includes one free <%= PHOTO_BOOTH_PARTNER %> picture.</p>
      <form action="/reserve" method="post" id="ticketForm">
        <label>Buyer full name<input name="buyerName" required placeholder="Buyer name"></label>
        <label>Buyer email<input type="email" name="buyerEmail" required placeholder="you@example.com"></label>
        <label>Quantity<input id="quantity" type="number" name="quantity" min="1" max="10" value="1" required></label>
        <div id="attendeeForms"></div>
        <p id="duplicateWarning" class="bad hidden">The same attendee name cannot be used twice.</p>
        <p class="note"><b>Important:</b> Each ticket name must match the attendee's ID at the door. Every attendee must wear <%= DRESS_CODE %>.</p>
        <p id="ageWarning" class="bad hidden">All attendees must be <%= MIN_AGE %>+ on <%= EVENT_DATE %>.</p>
        <p class="summary"><b>Total:</b> <span id="total"><%= money(TICKET_PRICE) %></span></p>
        <button class="button" type="submit">Reserve & Pay</button>
      </form>
    </div>
  </section>

  <section class="wrap"><div class="panel"><p class="eyebrow">The experience</p><h2>Luxury from the first click to the door.</h2><p>Guests immediately understand the value: a curated all-white dress code, Cremisan vineyard sunset atmosphere, house music, lighting, a free Pica Pic photo booth picture, and secure digital tickets. The event is designed around photos, music, and flow, while the approved guest list and QR check-in keep the night organized and exclusive.</p></div></section>

<script>
const priceCents = <%= TICKET_PRICE %>;
const minAge = <%= MIN_AGE %>;
const eventDate = new Date('2026-07-24T17:30:00');
const maxDob = new Date(eventDate);
maxDob.setFullYear(maxDob.getFullYear() - minAge);
const quantity = document.getElementById('quantity');
const attendeeForms = document.getElementById('attendeeForms');
const total = document.getElementById('total');
const duplicateWarning = document.getElementById('duplicateWarning');
const ageWarning = document.getElementById('ageWarning');
function money(cents){ return (cents / 100).toFixed(0) + ' NIS'; }
function renderForms(){
  const qty = Math.max(1, Math.min(10, Number(quantity.value || 1)));
  attendeeForms.innerHTML = '';
  for(let i = 1; i <= qty; i++){
    const div = document.createElement('div');
    div.className = 'attendee-box';
    div.innerHTML = `<h3>Ticket ${i}</h3><p class="note"><b>Door rule:</b> The first and last name on this ticket must match the attendee's ID. Dress code is <%= DRESS_CODE %>.</p><div class="name-grid"><label>First name<input name="attendeeFirstName" class="attendee-first-name attendee-name-part" required autocomplete="given-name" placeholder="First name"></label><label>Last name<input name="attendeeLastName" class="attendee-last-name attendee-name-part" required autocomplete="family-name" placeholder="Last name"></label></div><label>Date of birth <span class="hint">DD/MM/YYYY</span><input type="text" name="attendeeDob" class="attendee-dob" required inputmode="numeric" autocomplete="bday" maxlength="10" pattern="\\d{2}/\\d{2}/\\d{4}" placeholder="DD/MM/YYYY"></label><p class="age-help muted">Type the birthday as day / month / year. Example: 24/07/2004. Age is checked automatically.</p><p class="age-result muted"></p><label>Gender<select name="attendeeGender" class="attendee-gender" required><option value="">Select gender</option><option value="female">Female</option><option value="male">Male</option></select></label>`;
    attendeeForms.appendChild(div);
  }
  total.textContent = money(priceCents * qty);
  checkDuplicates();
}
function parseDob(value){
  const match = String(value || '').match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
  if(!match) return null;
  const day = Number(match[1]);
  const month = Number(match[2]);
  const year = Number(match[3]);
  const dob = new Date(year, month - 1, day);
  if(dob.getFullYear() !== year || dob.getMonth() !== month - 1 || dob.getDate() !== day || dob > eventDate) return null;
  return dob;
}
function calculateAge(dobValue){
  const dob = parseDob(dobValue);
  if(!dob) return null;
  let age = eventDate.getFullYear() - dob.getFullYear();
  const monthDiff = eventDate.getMonth() - dob.getMonth();
  if(monthDiff < 0 || (monthDiff === 0 && eventDate.getDate() < dob.getDate())) age--;
  return age;
}
function formatDobInput(input){
  const digits = input.value.replace(/\D/g, '').slice(0, 8);
  let formatted = digits;
  if(digits.length > 4) formatted = digits.slice(0,2) + '/' + digits.slice(2,4) + '/' + digits.slice(4);
  else if(digits.length > 2) formatted = digits.slice(0,2) + '/' + digits.slice(2);
  input.value = formatted;
}
function validateForm(){
  const names = [...document.querySelectorAll('.attendee-box')].map(box => ((box.querySelector('.attendee-first-name')?.value || '') + ' ' + (box.querySelector('.attendee-last-name')?.value || '')).trim().toLowerCase().replace(/\s+/g, ' ')).filter(Boolean);
  const hasDupes = new Set(names).size !== names.length;
  duplicateWarning.classList.toggle('hidden', !hasDupes);
  let underAge = false;
  document.querySelectorAll('.attendee-box').forEach(box => {
    const dobInput = box.querySelector('.attendee-dob');
    const output = box.querySelector('.age-result');
    const age = calculateAge(dobInput.value);
    if(!dobInput.value){ output.textContent = ''; return; }
    if(dobInput.value.length < 10 || age === null || age < minAge){
      underAge = true;
      output.textContent = dobInput.value.length < 10 ? 'Enter date as DD/MM/YYYY.' : `Not eligible — attendee must be ${minAge}+ on event day.`;
      output.className = 'age-result bad';
    } else {
      output.textContent = `Age on event day: ${age} ✓ Eligible`;
      output.className = 'age-result good';
    }
  });
  ageWarning.classList.toggle('hidden', !underAge);
  return !hasDupes && !underAge;
}
function checkDuplicates(){ return validateForm(); }
quantity.addEventListener('input', renderForms);
document.addEventListener('input', e => { if(e.target.matches('.attendee-dob')) formatDobInput(e.target); if(e.target.matches('.attendee-name-part,.attendee-dob,.attendee-gender')) validateForm(); });
document.getElementById('ticketForm').addEventListener('submit', e => { if(!validateForm()) e.preventDefault(); });
renderForms();
</script>
</body>
</html>
