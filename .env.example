NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
TICKET_LIMIT=500
# Keep this aligned with the displayed EVENT_DATE and EVENT_TIME when changing events.
EVENT_START_AT=2026-07-24T17:30:00

DATABASE_URL=
DATABASE_SSL=true
SESSION_SECRET=change-this-to-a-long-random-secret

STRIPE_SECRET_KEY=sk_test_or_sk_live_from_stripe_dashboard
STRIPE_WEBHOOK_SECRET=whsec_from_stripe_webhook

ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORDS=admin_password_1,admin_password_2

WHATSAPP_1=972568576684
INSTAGRAM_URL=https://www.instagram.com/dj_loco.antwan/

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password
EMAIL_FROM=ASIL'E Tickets <your_email@example.com>

# Optional Priority Access protection. Defaults are 5 submissions per IP in 15 minutes.
WAITLIST_RATE_LIMIT=5
WAITLIST_RATE_WINDOW_MS=900000

# Required before marketing emails can be sent. Keep this different from the session secret.
EMAIL_UNSUBSCRIBE_SECRET=generate-a-long-random-secret

# Marketing drafts and audience estimates work without these. Campaign sending remains
# disabled until an approved bulk provider, queue, suppression list, and event webhooks are configured.
MARKETING_SENDER_NAME=Asile Events
MARKETING_REPLY_TO=your_email@example.com
